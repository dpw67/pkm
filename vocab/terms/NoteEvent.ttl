@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:NoteEvent a skos:Concept ;
    rdfs:label "NoteEvent"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:DiabetesEvent ;
    skos:broader pkmv:DiabetesEvent ;
    skos:definition "Something to record related to a note associated with an event."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "NoteEvent"@en ;
    skos:scopeNote "Events related to note creation, modification, or lifecycle (e.g. an Obsidian note created/updated), distinct from ScriptEvent (automation-triggered)."@en .

