pkmv:MealDomain skos:member pkmv:DMPMealPlan .

pkmv:DMPMealPlan a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    skos:broader pkmv:MealPlan ;
    skos:definition "A weekly meal plan sourced from Diabetes Meal Plans (dmpmembers.com), a diabetes recipe and meal-plan subscription service."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "DMP Meal Plan"@en ;
    skos:scopeNote "Primary weekly meal-planning source; recipes exposed by Wordpress Recipe Maker (WPRM) API and imported into Plan to Eat and the PKM Meals app."@en .

