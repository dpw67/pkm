@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DublinCore a skos:Concept ;
    rdfs:label "Dublin Core"@en ;
    dcterms:created "2026-09-19"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    skos:broader pkmv:MetadataStandards ;
    skos:definition "A general-purpose metadata standard originally developed by librarians to capture metadata for publishing documentation on the web."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Dublin Core"@en ;
    skos:scopeNote "- Developed by the Dublin Core Metadata Initiative (DCMI), it includes core elements such as identifier, title, description, creator, date (created, modified, issues), subject, source, contributor, language, publisher, type, format, rights, and relation to describes resources of any kind across domains."@en .

