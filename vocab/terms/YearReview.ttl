@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:YearCollection skos:member pkmv:YearReview .

pkmv:YearReview a skos:Concept ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:YearCluster ;
    skos:broader pkmv:YearCluster ;
    skos:definition "A structured retrospective evaluating a completed year."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Year Review"@en ;
    skos:scopeNote "Assesses the year against the YearPlan."@en .

