@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MealDomain skos:member pkmv:RecipeSource .

pkmv:RecipeCollection skos:member pkmv:RecipeSource .

pkmv:RecipeSource a skos:Concept ;
    rdfs:label "Recipe Source"@en ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:Recipe ;
    skos:broader pkmv:Recipe ;
    skos:definition "The origin or provenance of a recipe, such as the website, cookbook, or person it was sourced from."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Recipe Source"@en ;
    skos:scopeNote "Attribution/provenance metadata (e.g. PTE, DMP as web sources), distinct from RecipeImages or Nutrition."@en .

