@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:RecipeCollection a skos:Collection ;
    rdfs:label "Recipe Collection"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Ingredient,
        pkmv:Nutrition,
        pkmv:Recipe,
        pkmv:RecipeImages,
        pkmv:RecipeServings,
        pkmv:RecipeSource,
        pkmv:RecipeTime ;
    skos:note "Recipe and its six parts listed flat: the ingredients, nutrition, timings, servings, source and images a recipe is assembled from. It enumerates by hand what the hierarchy already derives, and currently matches it exactly."@en ;
    skos:prefLabel "Recipe Collection"@en .

