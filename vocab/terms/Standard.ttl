pkmv:Standard a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    isothes:narrowerGeneric pkmv:ISOStandard,
        pkmv:SKOS,
        pkmv:W3CStandard ;
    skos:broader pkmv:KnowledgeSystem ;
    skos:definition "A documented specification, format, or set of rules established by a recognized body, intended for consistent, repeated use."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:ISOStandard,
        pkmv:SKOS,
        pkmv:W3CStandard ;
    skos:prefLabel "Standard"@en ;
    skos:scopeNote "Parent concept for ISOStandard and W3CStandard, and for related individual standards such as SKOS, OWL, and RDF."@en .

