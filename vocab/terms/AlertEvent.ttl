pkmv:AlertEvent a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:DiabetesEvent ;
    skos:broader pkmv:DiabetesEvent ;
    skos:definition "An exception condition raised by a device threshold setting, or other metric."@en ;
