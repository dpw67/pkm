pkmv:PKMMeals a skos:Concept ;
    rdfs:label "PKM Meals"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMSwift ;
    isothes:narrowerPartitive pkmv:Event,
        pkmv:Meal,
        pkmv:Recipe ;
    skos:broader pkmv:PKMSwift ;
    skos:changeNote "2026-08-29 — Renamed from “NewConcept” to “PKMMeals”; Preferred label “PKM Meals@en” added; Definition added; Scope note added (by Doug Warren)"@en,
        "2026-08-29 — Term created (by Doug Warren)"@en,
        "2026-08-29 — Unmarked as a top concept; Parent “PKM Swift” added (by Doug Warren)"@en,
        "Added definition and scope notes for PKM Meals."@en,
        "Removed as Top Concept and moved under PKM Swift."@en ;
    skos:definition "A SwiftUI app that manages events, recipes, and meals in a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Event,
        pkmv:Meal,
        pkmv:Recipe ;
    skos:prefLabel "PKM Meals"@en ;
    skos:scopeNote """- Available on macOS, iOS, iPadOS, and watchOS.
- Uses Python and Swift services, scripts, commands, and agents.
- Integrates with Obsidian notes, Neo4j graph database, Claude AI LLM, and diabetes websites.
- Provides functions via the App Intents framework to offer actions for use in Shortcuts (workflows), Siri AI (voice interface & natural language), or Spotlight (search)."""@en .

