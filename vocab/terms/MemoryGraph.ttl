pkmv:MemoryGraph a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:GraphDatabase ;
    skos:broader pkmv:GraphDatabase ;
    skos:definition "A structured network of entities (nodes) and their relationships (edges), typically machine-readable, used to represent and query interconnected short-term and long-term memory."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Memory Graph"@en ;
    skos:scopeNote "- Important for services and agents."@en .

