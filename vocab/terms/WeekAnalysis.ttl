pkmv:WeekAnalysis a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:WeekCluster ;
    skos:broader pkmv:WeekCluster ;
    skos:definition "A note summarizing patterns, trends, or review findings across a week's Day Clusters."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Week Analysis"@en ;
    skos:scopeNote "Distinguish from WeekIndex (navigation) and from domain-specific analyses like WeekDiabetesAnalysis, scoped specifically to diabetes data."@en .

