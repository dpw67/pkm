@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:Event a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMMeals ;
    isothes:narrowerGeneric pkmv:HealthEvent,
        pkmv:ToolEvent,
        pkmv:UserEvent ;
    skos:broader pkmv:PKMMeals ;
    skos:definition "Something that happened."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:HealthEvent,
        pkmv:ToolEvent,
        pkmv:UserEvent ;
    skos:prefLabel "Event"@en ;
    skos:scopeNote "Top concept for the Event hierarchy; narrower concepts partition by originator (UserEvent, AgentEvent, DeviceEvent, AppEvent, ToolEvent, ServiceEvent) and by domain (HealthEvent, MealEvent, NoteEvent, ScriptEvent, ActivityEvent)."@en .

