pkmv:Map a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Map"@en ;
    rdfs:label "Map"@en ;
    skos:altLabel "Map of Content"@en, "MOC"@en ;
    skos:definition "A note used to think, plan, and organize a group of other notes."@en ;
    skos:scopeNote "- It might begin as an index or hub note for a collectio of other related notes.\n- This typically evolves into a more structured map by collecting links into related groups, adding headings to establish more organization, and additional commentary to provide more context and information.\n- Connected with other maps in a network to provide organization and navigation for the linked notes in a PKM system."@en ;
    skos:changeNote "Added definition and scope notes for a Map."@en, "2026-08-29 — Duplicated from “Note” (by Doug Warren)", "2026-08-29 — Renamed from “NoteCopy” to “Map”; Preferred label changed from “Note@en” to “Map@en”; Alternative label “Map of Content@en” added; Alternative label “MOC@en” added; Definition updated; Scope note updated (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianNotes .

pkmv:BookSearch a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Book Search"@en ;
    rdfs:label "Book Search"@en ;
    skos:definition "Query book by title, author, publisher, or ISBN, and get book information via Google Books API for properties."@en ;
    skos:scopeNote "Simplifies creation of Book notes by downloading relevant properties and cover image."@en ;
    skos:changeNote "Added definition and scope notes for Book Search."@en, "2026-08-29 — Term created under “Obsidian Plugin” (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “BookSearch”; Preferred label “Book Search@en” added; Definition added; Scope note added (by Doug Warren)" ;
