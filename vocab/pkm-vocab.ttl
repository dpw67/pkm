    skos:changeNote "2026-08-29 — Definition updated (by Doug Warren)"@en,
        "2026-08-29 — Duplicated from “Effort Plan” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “EffortPlanCopy” to “EffortReview”; Preferred label changed from “Effort Plan@en” to “Effort Review@en” (by Doug Warren)"@en,
        "2026-08-29 — Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Effort Review."@en ;
    skos:definition "A structured retrospective evaluating an effort."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Effort Review"@en ;
