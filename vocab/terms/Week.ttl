pkmv:WeekCollection skos:member pkmv:Week .

pkmv:Week a skos:Concept ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:Calendar ;
    isothes:narrowerPartitive pkmv:Day ;
    skos:broader pkmv:Calendar ;
    skos:definition "A seven-day time period grouping consecutive days."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Day ;
    skos:prefLabel "Week"@en ;
    skos:related pkmv:WeekCluster ;
    skos:scopeNote "Contains Days via IN_WEEK: parent time horizon for weekly planning, log, journal, and review artifacts."@en .

