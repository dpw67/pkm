pkmv:DayMeal a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:MealPlan ;
    isothes:narrowerGeneric pkmv:Breakfast,
        pkmv:Dinner,
        pkmv:Lunch,
        pkmv:Snack ;
    skos:broader pkmv:MealPlan ;
    skos:definition "A single planned or eaten meal within a day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Breakfast,
        pkmv:Dinner,
        pkmv:Lunch,
        pkmv:Snack ;
    skos:prefLabel "Day Meal"@en ;
    skos:scopeNote "A meal occasion instance: typed as Breakfast, Lunch, Dinner, or Snack."@en .

