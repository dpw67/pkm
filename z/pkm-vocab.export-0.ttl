pkm:collection a skos:Collection ;
    rdfs:label "Ideaverse"@en ;
    skos:note "Connected notes with the universe of ideas that exists between your brain and every place you think."@en ;
    skos:member pkm:Spark, pkm:Concept, pkm:Idea, pkm:Interest, pkm:Effort, pkm:Area, pkm:Action .

pkm:collection2 a skos:Collection ;
    rdfs:label "Day Cluster"@en ;
    skos:note "All the related notes for a single calendar Day."@en ;
    skos:member pkm:DayIndex, pkm:DayPlan, pkm:DayLog, pkm:DayJournal, pkm:DayReview, pkm:DayHealth, pkm:DayLinks, pkm:DayActions, pkm:DaySchedule, pkm:DayDiabetes, pkm:DayDiabetesAnalysis, pkm:DayAnalysis, pkm:Day .

pkm:collection3 a skos:Collection ;
    rdfs:label "Week Cluster"@en ;
    skos:note "All notes related to a single Week time period of seven consecutive days."@en ;
    skos:member pkm:WeekIndex, pkm:WeekPlan, pkm:WeekLog, pkm:WeekJournal, pkm:WeekReview, pkm:WeekHealth, pkm:WeekDiabetes, pkm:WeekDiabetesAnalysis, pkm:WeekAnalysis, pkm:WeekMealPlan, pkm:Week .

pkm:collection4 a skos:Collection ;
    rdfs:label "Month Cluster"@en ;
    skos:note "All related notes for a calendar month grouping Weeks and Days."@en .

pkm:collection5 a skos:Collection ;
    rdfs:label "Quarter Cluster"@en ;
    skos:note "All related notes for a time period of three Months uses for medium-term planning."@en .

pkm:collection6 a skos:Collection ;
    rdfs:label "Year Cluster"@en ;
    skos:note "All notes related to a calendar Year groups Quarters and Months."@en .

pkm:collection7 a skos:Collection ;
    rdfs:label "Decade Cluster"@en ;
    skos:note "All notes related to a ten-Year span used for long-range life planning."@en .

pkm:collection8 a skos:Collection ;
    rdfs:label "Life Cluster"@en ;
    skos:note "All notes related to the top time horizon of a full lifespan."@en .

pkm:collection9 a skos:Collection ;
    rdfs:label "Recipe Cluster"@en ;
    skos:note "All notes related to Ingredients, Instructions, and Nutrition about a Recipe for preparing, cooking, and eating food as a Meal or Snack."@en ;
    skos:member pkm:Recipe, pkm:Ingredient, pkm:RecipeTime, pkm:RecipeServings, pkm:RecipeSource, pkm:RecipeImages, pkm:Nutrition, pkm:Meal, pkm:MealPlan .

pkm:collection10 a skos:Collection ;
    rdfs:label "Concept Cluster"@en ;
    skos:note "All notes related to a Concept."@en ;
    skos:member pkm:Concept, pkm:Term, pkm:Taxonomy, pkm:Ontology, pkm:KnowledgeGraph, pkm:Metadata, pkm:SKOS, pkm:RDF, pkm:OWL, pkm:Cypher .

pkm:doc1 a foaf:Document ;
    dcterms:title "RDF/RDFS Ontology Glossary"@en ;
    foaf:page <https://jessicatalisman.substack.com/p/ontology-glossary> ;
    rdfs:comment "Substack essay on Ontology Part IV including link to download an abbreviated Ontology Glossary."@en .

pkm:doc2 a foaf:Document ;
    dcterms:title "RDF/RDFS Ontology Glossary (Abbreviated)"@en ;
    foaf:page <https://jessicatalisman.substack.com/api/v1/file/75abcfc1-acec-4f9c-aeb2-6a27d455ffd5.pdf> ;
    rdfs:comment "A 6-page abbreviated RDF Ontology Glossary available as a downloadable PDF document."@en .

pkm:doc3 a foaf:Document ;
    dcterms:title "PKM URI Namespace (https://w3id.org/pkm)"@en ;
    foaf:page <https://w3id.org/pkm> ;
    rdfs:comment "Persistent URi namespace for Personal Knowledge Management (PKM) and Knowledge System Architecture (KSA). This includes glossary (terms), taxonomy (concepts, hierarchy, related, etc.), thesaurus, ontology (classes, individuals, properties, relations, rules), knowledge graph (nodes, relationships, properties, queries), metadata schema (JSON, CSV, etc,), tools (Python, Swift, Cypher, SQL, etc.), and resources (website, notes, repositories, etc.)."@en .

pkm:agent1 a prov:Person ;
    foaf:name "Jessica Talisman" ;
    foaf:homepage <https://www.ontologypipeline.com/> .

pkm:agent2 a prov:Person ;
    foaf:name "Doug Warren" ;
    foaf:homepage <https://blog.warrenweb.net> .
