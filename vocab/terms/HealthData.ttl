@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:HealthData a skos:Concept ;
    rdfs:label "Health Data"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:definition "Personal health and diabetes data from websites and HealthKit collected from my wearable devices and iOS apps."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:AppleHealth,
        pkmv:DexcomData,
        pkmv:GlookoData ;
    skos:prefLabel "Health Data"@en ;
    skos:related pkmv:PKMPythonCommands,
        pkmv:PKMPythonScripts,
        pkmv:PKMPythonServices ;
    skos:scopeNote """- Includes Dexcom Clarity website with Dexcom API for glucose data.
- Includes Glooko website with PDF download containing Omnipod 5 insulin pump data.
- Includes Apple Health with health data from multiple apps."""@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

