@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ClaudeAI a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:definition "Claude AI LLM (Sonnet or Opus models) that support a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:ClaudeChat,
        pkmv:ClaudeCowork,
        pkmv:ClaudeDesktop ;
    skos:prefLabel "Claude AI"@en ;
    skos:related pkmv:PKMPythonServices ;
    skos:scopeNote """- Integrates AI with apps, services, scripts, commands, and agents.
- Generates analysis notes in Obsidian such as Day Diabetes Analysis and Day Analysis using pkm-review services, scripts, commands, and agents.
- Support an AI prompt library and additional dynamic AI chats with PKM system knowledge, context, and memory."""@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

