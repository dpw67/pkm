pkmv:DayCollection skos:member pkmv:DayMindmap .

pkmv:DayMindmap a skos:Concept ;
    rdfs:label "Day Mindmap"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterVisual ;
    skos:broader pkmv:DayClusterVisual ;
    skos:definition "An Obsidian Excalidraw drawing note using the Mindmap plugin."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Mindmap"@en ;
    skos:scopeNote "Useful for brainstorming, idea generation, planning, and organizing."@en .

