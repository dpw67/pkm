@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:YearCollection a skos:Collection ;
    rdfs:label "Year Collection"@en ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Year,
        pkmv:YearCluster,
        pkmv:YearHealth,
        pkmv:YearJournal,
        pkmv:YearLog,
        pkmv:YearPlan,
        pkmv:YearReview ;
    skos:note "Year, the Year Cluster and all five of its parts, listed flat. It enumerates by hand what the hierarchy already derives; where the two disagree the hierarchy under Year Cluster is authoritative."@en ;
    skos:prefLabel "Year Collection"@en .

