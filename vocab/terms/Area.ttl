@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortCollection skos:member pkmv:Area .

pkmv:NoteTypes skos:member pkmv:Area .

pkmv:Area a skos:Concept ;
    rdfs:label "Area"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:EffortsFolder ;
    skos:broader pkmv:EffortsFolder ;
    skos:definition "An ongoing sphere of responsibility or activity with a standard to be maintained over time, without a defined completion date."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Finance,
        pkmv:Health,
        pkmv:Life ;
    skos:prefLabel "Area"@en ;
    skos:scopeNote "Per the PARA method; distinct from Project (has an end state) and Interest (topic without an ownership obligation)."@en .

