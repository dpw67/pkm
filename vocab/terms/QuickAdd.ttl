@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:QuickAdd a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin ;
    skos:definition "Extension for Obsidian that includes additional tools (choices): templates, captures, macros, and multis."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "QuickAdd"@en ;
    skos:scopeNote """- Templates define how to create a new note using Templater; for example, allows definition of a quick action that creates a new note in a specific location, with a templatized title, and templated content.
- A capture allows you to quickly add content to predefined files, like adding a link to an open file to a Day cluster note under a particular section.
- Macros allow you to combine captures and templates into a chained workflow, often using an assigned hotkey.
- Multi choices are organizational so you can have folders of other choices.
- QuickAdd format syntax is available for all choices."""@en .

