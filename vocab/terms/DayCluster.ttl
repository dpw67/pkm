@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCluster a skos:Concept ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:TimeCluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:DayClusterCore,
        pkmv:DayClusterHealth,
        pkmv:DayClusterSupport,
        pkmv:DayClusterVisual ;
    skos:broader pkmv:CalendarFolder,
        pkmv:TimeCluster ;
    skos:definition "The set of structured notes and artifacts generated for a single day within the PKM system, organized into core, support, health, and visual groupings."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:DayClusterCore,
        pkmv:DayClusterHealth,
        pkmv:DayClusterSupport,
        pkmv:DayClusterVisual ;
    skos:prefLabel "Day Cluster"@en ;
    skos:related pkmv:Day ;
    skos:scopeNote "The central organizing pattern of this system. Narrower concepts (DayClusterCore, DayClusterHealth, DayClusterSupport, DayClusterVisual) partition each day's artifacts; mirrors the Week/Month clusters at other granularities."@en .

