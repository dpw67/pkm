    skos:broader pkmv:ObsidianPlugin .

pkmv:Templater a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Templater"@en ;
    rdfs:label "Templater"@en ;
    skos:definition "Create and use dynamic templates with a templating language that inserts variables and functions into notes, along with JavaScript code."@en ;
    skos:scopeNote "- Provides a consistent structure and layout for specific types of notes."@en ;
    skos:changeNote "Added definition and scope notes for Templater."@en, "2026-08-29 — Duplicated from “Book Search” (by Doug Warren)", "2026-08-29 — Renamed from “BookSearchCopy” to “Templater”; Preferred label changed from “Book Search@en” to “Templater@en”; Definition updated; Scope note updated (by Doug Warren)" ;
