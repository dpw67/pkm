    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Obsidian Settings"@en ;
    rdfs:label "Obsidian Settings"@en ;
    skos:definition "A hidden folder (`.obsidian`) in every Obsidian vault that contains settings for Obsidian and its plugins."@en ;
