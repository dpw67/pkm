@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:TimeCollection a skos:Collection ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Time,
        pkmv:TimeCluster ;
    skos:note "All the related concepts about Time."@en ;
    skos:prefLabel "Time Collection"@en .

