@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:QuarterCollection skos:member pkmv:QuarterLog .

pkmv:QuarterLog a skos:Concept ;
    rdfs:label "Quarter Log"@en ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:QuarterCluster ;
    skos:broader pkmv:QuarterCluster ;
    skos:definition "A record of what happened over a quarter."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Quarter Log"@en ;
    skos:scopeNote "Quarterly factual roll-up; aggregates QuarterLog entries."@en .

