pkmv:QuarterCollection skos:member pkmv:QuarterPlan .

pkmv:QuarterPlan a skos:Concept ;
    rdfs:label "Quarter Plan"@en ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:QuarterCluster ;
    skos:broader pkmv:QuarterCluster ;
    skos:definition "The plan of intended priorities for a quarter."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Quarter Plan"@en ;
    skos:scopeNote "Forward-looking quarterly intentions; parent context for MonthPlans."@en .

