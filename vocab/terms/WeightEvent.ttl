@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:WeightEvent a skos:Concept ;
    rdfs:label "Weight Event"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    isothes:broaderGeneric pkmv:HealthEvent ;
    skos:broader pkmv:HealthEvent ;
    skos:definition "A record of current weight."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Weight Event"@en ;
    skos:scopeNote """- Stepping on a weight scale, and logging the weight displayed.
- If an Bluetooth-enable scale, capture the current weight reading."""@en .

