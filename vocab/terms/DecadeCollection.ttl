@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:DecadeCollection a skos:Collection ;
    rdfs:label "Decade Collection"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Decade ;
    skos:note "Decade alone. No decade notes are generated and no narrower concepts exist, so this records an intention rather than a grouping."@en ;
    skos:prefLabel "Decade Collection"@en .

