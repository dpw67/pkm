@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortReview a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:EffortCluster ;
    skos:definition "A structured retrospective evaluating an effort."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Effort Review"@en ;
    skos:scopeNote """- Output of the Effort Review workflow: assesses the actual Effort Log against the Effort Plan intentions.
- Includes Plus-Minus-Next (PMN) analysis by Claude AI: what worked, what needs improving, and what's next."""@en .

