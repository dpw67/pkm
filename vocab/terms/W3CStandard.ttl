@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:SemanticWebStandards skos:member pkmv:W3CStandard .

pkmv:W3CStandard a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:Standard ;
    isothes:narrowerGeneric pkmv:OWL,
        pkmv:RDF ;
    skos:broader pkmv:Standard ;
    skos:definition "A standard or recommendation published by the World Wide Web Consortium (W3C)."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:OWL,
        pkmv:RDF,
        pkmv:SKOS ;
    skos:prefLabel "W3C Standard"@en ;
    skos:scopeNote "Covers the semantic web standards underlying this vocabulary - SKOS, OWL, RDF - as a class distinct from ISO standards."@en .

