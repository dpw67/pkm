@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:GlucoseEvent a skos:Concept ;
    rdfs:label "Glucose Event"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    isothes:broaderGeneric pkmv:DiabetesEvent ;
    skos:broader pkmv:DiabetesEvent ;
    skos:definition "Something that happened related to Glucose."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Glucose Event"@en ;
    skos:scopeNote "Narrower than HealthEvent (and DiabetesEvent); a single blood-glucose reading synced via the health-tracking pipeline."@en .

