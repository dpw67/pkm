// {{ title }} -- conformance harness
//
// Generated from {{ source }}. Do not edit; edit the schema and re-run
// `make artifacts`.
//
// Run it with `make swiftrun`. This exists because compiling the generated
// code proves almost nothing about it: `make swiftcheck` passed on a version
// that trapped inside SwiftData on the first insert, and on a version that
// silently reordered every to-many relationship. Both needed a container, a
// context, and real rows to show up.
//
// Everything asserted here is derived from the schema, so the harness follows
// it. What it checks, in order:
//
//   1. the fixture decodes           -- the coders agree with the slot names
//   2. every row imports             -- SwiftData accepts each stored shape
//   3. payload -> store -> payload   -- nothing is lost in either mapping
//   4. re-import changes no counts   -- upsert is upsert, not insert
//
// Step 3 compares to-many relationships as multisets. A SwiftData
// relationship is a set, so the order a list was written in is not stored
// anywhere; see the note in Models.swift.

import Foundation
import SwiftData

@main
struct {{ module }}Smoke {
    static func main() {
        do { try run() } catch { fail("\(error)") }
        if failures == 0 {
            print("ok -- \(checks) checks passed")
        } else {
            print("FAILED -- \(failures) of \(checks) checks")
            exit(1)
        }
    }

    static var checks = 0
    static var failures = 0

    static func expect(_ ok: Bool, _ what: String) {
        checks += 1
        if !ok { failures += 1; print("  FAIL \(what)") }
    }

    static func fail(_ what: String) {
        checks += 1
        failures += 1
        print("  FAIL \(what)")
    }

    /// The fixture: the first argument, or the copy `make artifacts` writes
    /// beside the module.
    ///
    /// Taking an argument means the harness can be pointed at any fixture of
    /// this schema, and does not depend on where the binary was built. The
    /// `#filePath` fallback only holds while the generated tree is intact.
    static func fixtureURL() -> URL {
        if let given = CommandLine.arguments.dropFirst().first {
            return URL(fileURLWithPath: given)
        }
        return URL(fileURLWithPath: #filePath)
            .deletingLastPathComponent()          // the harness directory
            .deletingLastPathComponent()          // generated/swift
            .appendingPathComponent("{{ module }}/fixture.json")
    }

    static func run() throws {
        let url = fixtureURL()
        let fixture = try {{ module }}Coding.decoder.decode(
            {{ module }}Fixture.self, from: Data(contentsOf: url))
{% for shape in model.declared_nodes %}
        print("decoded \(fixture.{{ shape.name | plural }}.count) {{ shape.name | plural }}")
{% endfor %}

        let container = try {{ module }}Store.container(inMemory: true)
        let context = ModelContext(container)
        try {{ module }}Importer(context: context).load(fixture)

        // 2. Every fixture row reached the store, and no extra row appeared.
{% for shape in model.declared_nodes %}
        let {{ shape.name | camel }}s = try {{ shape.name }}Repository(context: context).all()
        expect({{ shape.name | camel }}s.count == fixture.{{ shape.name | plural }}.count,
               "{{ shape.name }} count: stored \({{ shape.name | camel }}s.count), fixture \(fixture.{{ shape.name | plural }}.count)")
{% endfor %}
{% for shape in model.associations %}
        let {{ shape.name | camel }}s = try context.fetch(FetchDescriptor<{{ shape.name }}>())
        print("stored \({{ shape.name | camel }}s.count) {{ shape.name | plural }}")
{% endfor %}

        // 3. Round trip. Sorted by id on both sides, since neither a fetch nor
        //    a fixture promises an order for the rows themselves.
{% for shape in model.declared_nodes %}
        for (want, got) in zip(fixture.{{ shape.name | plural }}.sorted { $0.id < $1.id },
                               {{ shape.name | camel }}s.map(\.dto).sorted { $0.id < $1.id }) {
            expect(same(want, got), "{{ shape.name }} \(want.id) round trip")
        }
{% endfor %}

        // 4. Upsert twice, get the same store.
{% for shape in model.declared_nodes %}
        let {{ shape.name | camel }}sBefore = {{ shape.name | camel }}s.count
{% endfor %}
        try {{ module }}Importer(context: context).load(fixture)
{% for shape in model.declared_nodes %}
        expect(try {{ shape.name }}Repository(context: context).all().count == {{ shape.name | camel }}sBefore,
               "{{ shape.name }} count unchanged after re-import")
{% endfor %}
{% for shape in model.associations %}
        expect(try context.fetch(FetchDescriptor<{{ shape.name }}>()).count == {{ shape.name | camel }}s.count,
               "{{ shape.name }} count unchanged after re-import")
{% endfor %}
    }
}

/// Payload equality that treats a to-many member as a multiset.
///
/// Two payloads are the same record if they hold the same values; a stored
/// relationship cannot promise the order its list was written in, so a
/// comparison that insisted on it would report a difference the schema never
/// asked to preserve.
{% for shape in model.declared_nodes %}
func same(_ a: {{ shape.name }}DTO, _ b: {{ shape.name }}DTO) -> Bool {
{% set loose = shape.members | selectattr("multivalued") | select("relationship") | list %}
{% if loose %}
    var a = a, b = b
{% for m in loose %}
    // {{ m.name }} is a relationship in the store, so its order is not stored.
    let a{{ loop.index }} = a.{{ m.name | camel }}, b{{ loop.index }} = b.{{ m.name | camel }}
    guard a{{ loop.index }}.count == b{{ loop.index }}.count,
          a{{ loop.index }}.allSatisfy({ x in b{{ loop.index }}.contains(x) }) else { return false }
    a.{{ m.name | camel }} = []
    b.{{ m.name | camel }} = []
{% endfor %}
    return a == b
{% else %}
    return a == b
{% endif %}
}

{% endfor %}
