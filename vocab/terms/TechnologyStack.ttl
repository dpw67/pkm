@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:TechnologyStack a skos:Concept ;
    rdfs:label "Technology Stack"@en ;
    dcterms:created "2026-09-18"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    skos:definition "A tool, platform, language, service, or protocol used to build or run a system, as distinct from the concepts the system organizes."@en ;
    skos:editorialNote "Currently, technology and tools are intermingled with concepts, but they will be separated into a separate Systems scheme with the 0.2.0 split from Subjects. Maybe \"Technology Foundation\" would be a better label because \"stack\" implies vertical arrangement — consider for version 0.2.0."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Technology Stack"@en ;
    skos:scopeNote "Technology-specific terms belong here rather than under the concepts they implement, so the generic vocabulary stays readable by someone using different tools."@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

