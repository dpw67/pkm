    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianNotes .

pkmv:View a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "View"@en ;
    rdfs:label "View"@en ;
    skos:definition "A note that offers a view perspective of related notes as a dashboard, dynamic queries, or embedded bases. "@en ;
    skos:scopeNote "Helps presentation and navigation for a collection of notes."@en ;
    skos:changeNote "Added definition and scope notes for a View."@en, "2026-08-29 — Duplicated from “Note” (by Doug Warren)", "2026-08-29 — Renamed from “NoteCopy” to “View”; Preferred label changed from “Note@en” to “View@en”; Definition updated; Scope note updated (by Doug Warren)" ;
