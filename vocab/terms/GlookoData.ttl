@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:GlookoData a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:HealthData ;
    skos:definition "Diabetes data from Insulet-provided Glooko website that contain Omnipod 5 insulin pump data that is also integrated with Dexcom data for glucose, meals, and other events."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Glooko Data"@en ;
    skos:scopeNote """- Includes data from Glooko PDF reports for insulin pump data.
- A Glooko API is available, but requests for approval have been ignored."""@en .

