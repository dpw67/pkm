@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:WeekCollection a skos:Collection ;
    rdfs:label "Week Collection"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Week,
        pkmv:WeekAnalysis,
        pkmv:WeekDiabetes,
        pkmv:WeekDiabetesAnalysis,
        pkmv:WeekHealth,
        pkmv:WeekIndex,
        pkmv:WeekJournal,
        pkmv:WeekLog,
        pkmv:WeekMealPlan,
        pkmv:WeekPlan,
        pkmv:WeekReview ;
    skos:note "The ten parts of a Week Cluster listed flat, together with Week itself. It enumerates by hand what the hierarchy already derives; where the two disagree the hierarchy under Week Cluster is authoritative."@en ;
    skos:prefLabel "Week Collection"@en .

