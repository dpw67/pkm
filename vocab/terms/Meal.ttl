@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MealDomain skos:member pkmv:Meal .

pkmv:NoteTypes skos:member pkmv:Meal .

pkmv:Meal a skos:Concept ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMMeals ;
    isothes:narrowerPartitive pkmv:Food ;
    skos:broader pkmv:PKMMeals ;
    skos:definition "An eating occasion consisting of one or more foods or recipes consumed at a particular time."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Food,
        pkmv:MealPlan,
        pkmv:Restaurant ;
    skos:prefLabel "Meal"@en ;
    skos:scopeNote "Parent concept for the meal-planning domain (Breakfast, Lunch, Dinner, Snack, Recipe, DayMeal, etc.) - the occasion itself, not the recipe or ingredient content."@en .

