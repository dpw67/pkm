@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DiabetesEvent a skos:Concept ;
    rdfs:label "DiabetesEvent"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:HealthEvent ;
    isothes:narrowerGeneric pkmv:ActivityEvent,
        pkmv:AlertEvent,
        pkmv:DeviceEvent,
        pkmv:GlucoseEvent,
        pkmv:InsulinEvent,
        pkmv:MealEvent,
        pkmv:NoteEvent ;
    skos:broader pkmv:HealthEvent ;
    skos:definition "Something that happened related to Diabetes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:ActivityEvent,
        pkmv:AlertEvent,
        pkmv:DeviceEvent,
        pkmv:GlucoseEvent,
        pkmv:InsulinEvent,
        pkmv:MealEvent,
        pkmv:NoteEvent ;
    skos:prefLabel "DiabetesEvent"@en ;
    skos:scopeNote "Broader grouping for diabetes-related HealthEvent subtypes (GlucoseEvent, InsulinEvent); relates to WeekDiabetes/WeekDiabetesAnalysis at the weekly rollup."@en .

