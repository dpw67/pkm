// {{ title }} -- store access
//
// Generated from {{ source }}. Do not edit; edit the schema and re-run
// `make artifacts`.
//
// One repository per identified class, plus an importer that loads a fixture.
//
// Resolution is the only real work here. A payload carries references as ids,
// so storing one means fetching the far end -- and every repository does that
// through its peer rather than through a generic helper, because `#Predicate`
// cannot be written against an identifier it only knows through a protocol.
// The duplication is the price of a macro that wants a concrete type.
//
// Every `upsert` resolves before it writes, so a payload naming something that
// is not stored fails without leaving a half-linked record behind.

import Foundation
import SwiftData

/// A reference that could not be resolved.
public enum StoreError: Error, CustomStringConvertible {
    case missing(type: String, id: String)

    public var description: String {
        switch self {
        case let .missing(type, id):
            return "no \(type) with identifier \(id)"
        }
    }
}

