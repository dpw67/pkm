    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Month-xl-pref-en-1 ;
    skos:prefLabel "Month"@en ;
    skos:definition "A calendar month grouping weeks and days."@en ;
    skos:scopeNote "- Contains lower time horizons via IN_MONTH: parent horizon for monthly planning and review artifacts. \n- Each month contains multiple multiple weeks (4-5) and days (28-31).\n- There are 3 months in a quarter, and 12 months in a year."@en ;
    dcterms:created "2026-08-25T19:12:03Z"^^xsd:dateTime ;
    dcterms:modified "2026-08-25T19:12:03Z"^^xsd:dateTime ;
