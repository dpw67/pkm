@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:KnowledgeSystem a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:narrowerPartitive pkmv:Glossary,
        pkmv:Metadata,
        pkmv:Ontology,
        pkmv:Standard,
        pkmv:Taxonomy ;
    skos:broader pkmv:KnowledgeSystemArchitecture ;
    skos:definition "A system of organization, navigation, and access for knowledge."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Glossary,
        pkmv:Knowledge,
        pkmv:KnowledgeGraph,
        pkmv:Metadata,
        pkmv:Ontology,
        pkmv:Standard,
        pkmv:Taxonomy,
        pkmv:Term ;
    skos:prefLabel "Knowledge System"@en ;
    skos:scopeNote """- Includes the stages of development described by Jessica Talisman in her book "The Ontology Pipeline".
- Refers to standards for knowledge systems and semantic web with linked data like SKOS, RDF, and OWL."""@en .

