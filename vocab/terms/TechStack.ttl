@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:TechStack a skos:Collection ;
    rdfs:label "Tech Stack"@en ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Cypher,
        pkmv:FastAPI,
        pkmv:Hummingbird,
        pkmv:Neo4j,
        pkmv:Python,
        pkmv:Script,
        pkmv:Shortcut,
        pkmv:Siri,
        pkmv:Swift,
        pkmv:Tool ;
    skos:note "The languages, frameworks, and tools used to build and run the PKM system outside Obsidian: Python, Swift, Neo4j, Cypher, and Apple Shortcuts."@en ;
    skos:prefLabel "Tech Stack"@en .

