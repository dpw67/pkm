pkmv:DayAnalysis a skos:Concept ;
    rdfs:label "Day Analysis"@en ;
    dcterms:created "2026-08-24"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterCore ;
    skos:broader pkmv:DayClusterCore ;
    skos:changeNote "2026-08-24 — Definition added; Scope note added; Related term “Day Cluster” added; Related term “Day Index” added; Related term “Day Plan” added; Related term “Day Log” added; Related term “Day Review” added (by Doug Warren)"@en,
        "2026-08-27 — Unmarked as a top concept; Parent “Day Cluster” added (by Doug Warren)"@en,
        "2026-08-28 — Parent “Day Cluster Core” added; Parent “Day Cluster” removed (by Doug Warren)"@en,
        "2026-08-28 — Related term “Day Health” removed; Related term “Day Diabetes” removed; Related term “Day Diabetes Analysis” removed; Related term “Day Cluster” removed; Related term “Day Index” removed (by Doug Warren)"@en,
        "Added definition and scope notes for Day Analysis."@en ;
    skos:definition "Overall analytical synthesis of a day across domains."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Analysis"@en ;
    skos:scopeNote """- Includes Plus-Minus-Next analysis: overall, health, learning, and work.
- Generated by Claude AI during Morning Review workflow as a final report for the previous day.
- Compares DayPlan intentions and actual DayLog activities."""@en .

