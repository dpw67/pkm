<https://w3id.org/pkm/vocab> a skos:ConceptScheme ;
    dcterms:title "PKM Vocabulary"@en ;
    dcterms:description "This PKM vocabulary includes concepts for personal knowledge management (PKM) system associated with a  Knowledge System Architecture (KSA)."@en ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:publisher agents:Doug-Warren ;
    dcterms:contributor agents:Claude-AI, agents:Jessica-Talisman, agents:SKOS-Editor ;
    dcterms:created "2026-08-15"^^xsd:date ;
    dcterms:issued "2026-08-23"^^xsd:date ;
    dcterms:modified "2026-09-07"^^xsd:date ;
    dcterms:rights "Content: CC BY 4.0; examples and build scripts: CC0 1.0"@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "0.1.4" ;
    vann:preferredNamespacePrefix "pkmv" ;
    vann:preferredNamespaceUri "https://w3id.org/pkm/vocab/" ;
    dcterms:language "en" ;
    skos:hasTopConcept pkmv:Tool, pkmv:ObsidianNotes, pkmv:PKMSwift, pkmv:PKMPython, pkmv:GraphDatabase, pkmv:HealthData, pkmv:ClaudeAI, pkmv:KnowledgeSystemArchitecture .

pkmv:Recipe a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Recipe"@en ;
    rdfs:label "Recipe"@en ;
    skos:definition "A set of ingredients, instructions, nutrition, and information to prepare, cook, and eat a meal."@en ;
    skos:scopeNote "Reusable building block referenced by meals; imported into Plan to Eat and stored in the PKM Meals SwiftData SQL database, Obsidian Markdown notes, and Neo4j knowledge graph."@en ;
    skos:changeNote "Added definition and scope notes to Recipe in SKOS editor. Remove redundant Recipe2 generated by Proposals when already existed."@en, "2026-08-16 — Parent “Meal” added (by Doug Warren)", "2026-08-16 — Parent “Meal” removed; Related term “Meal” added (by Doug Warren)", "2026-08-24 — Definition added; Scope note added; Related term “MealPlan” added; Related term “Meal” removed; Linked artifact “Recipe” added (by Doug Warren)", "2026-08-26 — Definition updated (by Doug Warren)", "2026-08-29 — Parent “PKM Meals” added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept (by Doug Warren)", "2026-08-30 — Linked artifact “SKOS Concept” added; Linked artifact “https://schema.org/Recipe” removed (by Doug Warren)", "2026-08-31 — Linked artifact “schema:Recipe” added; Linked artifact “SKOS Concept” removed (by Doug Warren)", "2026-08-31 — Linked artifact “SKOS Concept” added; Linked artifact “schema:Recipe” removed (by Doug Warren)" ;
    dcterms:source resources:PKM-URI-Namespace ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-31"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMMeals ;
    skos:broader pkmv:PKMMeals ;
    rdfs:seeAlso <https://schema.org/Recipe> ;
    isothes:narrowerPartitive pkmv:Nutrition, pkmv:Ingredient, pkmv:RecipeTime, pkmv:RecipeServings, pkmv:RecipeSource, pkmv:RecipeImages ;
    skos:narrower pkmv:Nutrition, pkmv:Ingredient, pkmv:RecipeTime, pkmv:RecipeServings, pkmv:RecipeSource, pkmv:RecipeImages .

pkmv:PKMMeals a skos:Concept ;
    isothes:narrowerPartitive pkmv:Recipe, pkmv:Meal, pkmv:Event ;
    skos:narrower pkmv:Recipe, pkmv:Meal, pkmv:Event ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "PKM Meals"@en ;
    rdfs:label "PKM Meals"@en ;
    skos:definition "A SwiftUI app that manages events, recipes, and meals in a PKM system."@en ;
    skos:scopeNote "- Available on macOS, iOS, iPadOS, and watchOS.\n- Uses Python and Swift services, scripts, commands, and agents.\n- Integrates with Obsidian notes, Neo4j graph database, Claude AI LLM, and diabetes websites.\n- Provides functions via the App Intents framework to offer actions for use in Shortcuts (workflows), Siri AI (voice interface & natural language), or Spotlight (search)."@en ;
    skos:changeNote "Added definition and scope notes for PKM Meals."@en, "Removed as Top Concept and moved under PKM Swift."@en, "2026-08-29 — Term created (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “PKMMeals”; Preferred label “PKM Meals@en” added; Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “PKM Swift” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMSwift ;
    skos:broader pkmv:PKMSwift .

pkmv:Concept a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Concept"@en ;
    rdfs:label "Concept"@en ;
    skos:definition "A unit of thought in a knowledge organization system."@en ;
    skos:scopeNote "An abstract idea independent of its label. It's how we organize ideas for browsing and retrieval. a PKM Concept is based on the SKOS standard skos:Concept."@en ;
    skos:changeNote "Added definition and scope notes for Concept."@en, "2026-08-24 — Definition added; Scope note added; Linked artifact “skos:Concept” added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge” added (by Doug Warren)", "2026-08-31 — Linked artifact “SKOS Concept” added; Linked artifact “SKOS Concept” removed (by Doug Warren)" ;
    dcterms:source resources:RDF-Ontology-Glossary-Abbreviated, resources:RDF-Ontology-Glossary ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-24"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-31"^^xsd:date ;
    skos:related pkmv:Term ;
    isothes:broaderPartitive pkmv:Knowledge ;
    skos:broader pkmv:Knowledge ;
    rdfs:seeAlso skos:Concept .

pkmv:Knowledge a skos:Concept ;
    isothes:narrowerPartitive pkmv:Concept, pkmv:Topic, pkmv:Source, pkmv:Cluster ;
    skos:narrower pkmv:Concept, pkmv:Topic, pkmv:Source, pkmv:Cluster ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Knowledge"@en ;
    rdfs:label "Knowledge"@en ;
    skos:definition "Information, understanding, and skill acquired through experience, learning, or inference, retained and organized so it can be applied, communicated, or built upon."@en ;
    skos:scopeNote "Use as the broadest top concept anchoring the vocabulary; more specific forms (Metadata, Ontology, Taxonomy, KnowledgeGraph, Term) refine how knowledge is captured or represented. Not applied to individual notes directly."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Parent “Knowledge System” added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:KnowledgeSystem .

pkmv:KnowledgeSystem a skos:Concept ;
    skos:narrower pkmv:Knowledge, pkmv:Term, pkmv:Metadata, pkmv:Taxonomy, pkmv:Glossary, pkmv:Ontology, pkmv:KnowledgeGraph, pkmv:Standard ;
    isothes:narrowerPartitive pkmv:Metadata, pkmv:Taxonomy, pkmv:Glossary, pkmv:Ontology, pkmv:Standard ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Knowledge System"@en ;
    rdfs:label "Knowledge System"@en ;
    skos:definition "A system of organization, navigation, and access for knowledge."@en ;
    skos:scopeNote "- Includes the stages of development described by Jessica Talisman in her book \"The Ontology Pipeline\".\n- Refers to standards for knowledge systems and semantic web with linked data like SKOS, RDF, and OWL."@en ;
    skos:changeNote "Added definition and scope notes for Knowledge System."@en, "2026-08-29 — Term created under “Knowledge” (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “KnowledgeSystem”; Preferred label “Knowledge System@en” added; Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Parent “Knowledge” removed (by Doug Warren)", "2026-08-29 — Definition updated (by Doug Warren)", "2026-08-29 — Related term “Knowledge System Architecture” added (by Doug Warren)", "2026-08-30 — Parent “Knowledge System Architecture” added; Related term “Knowledge System Architecture” removed (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:KnowledgeSystemArchitecture .

pkmv:Action a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Action"@en ;
    rdfs:label "Action"@en ;
    skos:definition "Something to do for an effort, project, area, or interest. "@en ;
    skos:scopeNote "- Narrower than an Effort, and alongside Area, Interest, or Project.\n- May represent a single Action as a Task with many steps and more content than would simply be included in a bullet list.\n- More complex actions might be ActionGroups that have one or more nested groups of actions.\n- Sequential actions can be represented as a simple bullet list with a checkbox.\n- Parallel actions can use a numbered list to identify the sequence (1., 2., etc.).  "@en ;
    skos:changeNote "Added definition and scope notes for Action."@en, "2026-08-28 — Unmarked as a top concept; Parent “Effort” added (by Doug Warren)", "2026-08-29 — Definition added; Scope note added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:EffortsFolder ;
    skos:broader pkmv:EffortsFolder .

pkmv:EffortsFolder a skos:Concept ;
    isothes:narrowerGeneric pkmv:Action, pkmv:Area, pkmv:Interest, pkmv:Project ;
    skos:narrower pkmv:Action, pkmv:Area, pkmv:Interest, pkmv:Project ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Efforts Folder"@en ;
    rdfs:label "Efforts Folder"@en ;
    skos:altLabel "Effort Folder"@en ;
    skos:definition "A unit of directed work toward an outcome, such as a project or initiative."@en ;
    skos:scopeNote "Groups activity by goal; the intent behind logged actions."@en ;
    skos:changeNote "Added definition and scope notes. Removed redundant Effort2 created by Proposal when already existed."@en, "2026-08-25 — Created from approved proposal (proposed by Doug Warren) (by Doug Warren)", "2026-08-26 — Renamed from “Effort2” to “Effort” (by Doug Warren)", "2026-08-29 — Renamed from “Effort” to “EffortsFolder”; Unmarked as a top concept; Preferred label changed from “Effort@en” to “Efforts Folder@en”; Alternative label “Effort Folder@en” added; Parent “Vault” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    skos:broader pkmv:Vault .

pkmv:Meal a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Meal"@en ;
    rdfs:label "Meal"@en ;
    skos:definition "An eating occasion consisting of one or more foods or recipes consumed at a particular time."@en ;
    skos:scopeNote "Parent concept for the meal-planning domain (Breakfast, Lunch, Dinner, Snack, Recipe, DayMeal, etc.) - the occasion itself, not the recipe or ingredient content."@en ;
    skos:changeNote "2026-08-16 — Related term “MealPlan” added (by Doug Warren)", "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Parent “PKM Meals” added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMMeals ;
    skos:broader pkmv:PKMMeals ;
    isothes:narrowerPartitive pkmv:Food ;
    skos:narrower pkmv:Food, pkmv:Restaurant, pkmv:MealPlan .

pkmv:Term a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Term"@en ;
    rdfs:label "Term"@en ;
    skos:definition "A word or phrase used as the preferred or alternate label for a concept in a controlled vocabulary."@en ;
    skos:scopeNote "Refers to the lexical/label layer (skos:prefLabel, skos:altLabel), not the concept itself - use for discussing naming/labeling conventions distinct from the concepts terms denote."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)", "2026-08-29 — Related term “Concept” added; Related term “Taxonomy” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:KnowledgeSystem ;
    skos:related pkmv:Concept .

pkmv:Metadata a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Metadata"@en ;
    rdfs:label "Metadata"@en ;
    skos:definition "Structured data that describes, identifies, or provides context for another resource, such as a note, concept, or file."@en ;
    skos:scopeNote "Covers Obsidian YAML frontmatter properties, SKOS annotation properties, and similar descriptive attributes. Does not cover the content/body of a resource itself."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem .

pkmv:Taxonomy a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Taxonomy"@en ;
    rdfs:label "Taxonomy"@en ;
    skos:definition "A hierarchical classification scheme that organizes concepts into broader/narrower relationships."@en ;
    skos:scopeNote "Refers to the SKOS concept scheme built in the SKOS Editor - the structural layer between the flat Glossary stage and the formal Ontology stage."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)", "2026-08-29 — Related term “Term” removed (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem .

pkmv:Glossary a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Glossary"@en ;
    rdfs:label "Glossary"@en ;
    skos:definition "A list of concept terms and definitions."@en ;
    skos:scopeNote "- An on-ramp stage for building an ontology.\n- Focused on the names for concepts as terms, along with their definitions and scope notes.\n- Distinguished from a Taxonomy that includes structure with relationships between concept terms. \n- Also serves as a reference for the shared vocabulary of shared language for PKM systems."@en ;
    skos:changeNote "Add definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-29 — Duplicated from “Taxonomy” (by Doug Warren)", "2026-08-29 — Renamed from “TaxonomyCopy” to “Glossary”; Preferred label changed from “Taxonomy@en” to “Glossary@en”; Definition updated; Scope note updated (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem .

pkmv:Ontology a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Ontology"@en ;
    rdfs:label "Ontology"@en ;
    skos:definition "A formal, explicit specification of a shared conceptualization - the concepts, properties, and relationships within a domain, typically expressed in a language such as OWL."@en ;
    skos:scopeNote "Represents the formal layer following the SKOS taxonomy in the Glossary -> Taxonomy -> Ontology pipeline. Use for concepts/classes/axioms intended for formal reasoning, distinct from the looser Taxonomy stage."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem .

pkmv:KnowledgeGraph a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Knowledge Graph"@en ;
    rdfs:label "Knowledge Graph"@en ;
    skos:definition "A structured network of entities (nodes) and their relationships (edges), typically machine-readable, used to represent and query interconnected knowledge."@en ;
    skos:scopeNote "Refers specifically to the Neo4j graph instance mirroring and linking PKM notes and health events. Distinguish from Ontology (schema) and Taxonomy (classificatory hierarchy) - this is the populated data instance."@en ;
    skos:changeNote "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en, "2026-08-28 — Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:KnowledgeSystem, pkmv:GraphDatabase ;
    isothes:broaderPartitive pkmv:GraphDatabase .

pkmv:GraphDatabase a skos:Concept ;
    isothes:narrowerPartitive pkmv:KnowledgeGraph, pkmv:ContextGraph, pkmv:MemoryGraph ;
    skos:narrower pkmv:KnowledgeGraph, pkmv:ContextGraph, pkmv:MemoryGraph, pkmv:Neo4j, pkmv:Cypher, pkmv:Neo4jDesktop ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Graph Database"@en ;
    rdfs:label "Graph Database"@en ;
    skos:definition "Graph databases that support a PKM system."@en ;
    skos:scopeNote "- Includes Neo4j Desktop, Neo4j Community, Neo4j Aura (cloud), LadybugDB using Cypher graph query language.\n- Includes TypeDB using TypeQL."@en ;
    skos:changeNote "Added definition and scope notes for Graph Database."@en, "2026-08-29 — Term created (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “GraphDatabase”; Preferred label “Graph Database@en” added; Definition added; Scope note added (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date .

