@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:TimeCollection skos:member pkmv:TimeCluster .

pkmv:TimeCluster a skos:Concept ;
    rdfs:label "Time Cluster"@en ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    isothes:broaderGeneric pkmv:Cluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerGeneric pkmv:DayCluster,
        pkmv:MonthCluster,
        pkmv:QuarterCluster,
        pkmv:WeekCluster,
        pkmv:YearCluster ;
    skos:broader pkmv:CalendarFolder,
        pkmv:Cluster ;
    skos:definition "A group of related notes for a time period (or time horizon)."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:DayCluster,
        pkmv:MonthCluster,
        pkmv:QuarterCluster,
        pkmv:WeekCluster,
        pkmv:YearCluster ;
    skos:prefLabel "Time Cluster"@en ;
    skos:scopeNote """- Parent context for a group of related notes, like DayCluster, WeekCluster, MonthCluster, QuarterCluster, YearCluster, DecadeCluster, LifeCluster.
- Does not include other non-time clusters: EffortCluster, TopicCluster, ConceptCluster, OutputCluster, etc."""@en .

