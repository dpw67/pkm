pkmv:LocalRESTAPIWithMCP a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Local REST API with MCP"@en ;
    rdfs:label "Local REST API with MCP"@en ;
    skos:definition "Support automation for notes using REST API for apps or MCP server for AI agents."@en ;
    skos:scopeNote "- Enable Obsidian functions for Claude Desktop or Claude Code, Cursor, and other MCP clients such as Python services, scripts, or agents.\n- Create, read, update, or delete notes.\n- Patch specific sections of notes by heading, block, or frontmatter properties.\n- Search you vault using full-text or JsonLogic queries against note metadata (frontmatter, tags, path, or content).\n- Access the active Obsidian file.\n- List and execute commands.\n- Query tags.\n- Open files in Obsidian user interface."@en ;
    skos:changeNote "Added definition and scope notes for Local REST API with MCP."@en, "2026-08-29 — Duplicated from “Periodic Notes” (by Doug Warren)", "2026-08-29 — Renamed from “PeriodicNotesCopy” to “LocalRESTAPIWithMCP”; Preferred label changed from “Periodic Notes@en” to “Local REST API with MCP@en”; Definition updated; Scope note updated (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin .

pkmv:AdvancedURI a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Advanced URI"@en ;
    rdfs:label "Advanced URI"@en ;
    skos:definition "Control Obsidian features using special URIs to automate workflows."@en ;
    skos:scopeNote "- Open files, workspacces, headlngs, blocks, lines, and settings.\n- Open files in tabs, splits, windows, popovers, or silently in the background.\n- Switch between reading, source, and live preview mode.\n- Edit, overwrite, append, prepend, and create files.\n- Append or prepend content to specific heading, block, or line.\n- Write clipboard contents to notes, including daily notes.\n- Open bookmarks.\n- Automated search and replace, including regular expressions.\n- Call Obsidian and plugin commands.\n- Edit, read, and focus frontmatter properties\n- Navigate using file paths, file names, aliases, daily notes, or frontmatter UIDs\n- Create robust persistent IDs in properties that keep working when notes are renamed or moved.\n"@en ;
    skos:changeNote "Added definition and scope notes for Advanced URI."@en, "2026-08-29 — Duplicated from “Local REST API with MCP” (by Doug Warren)", "2026-08-29 — Renamed from “LocalRESTAPIWithMCPCopy” to “AdvancedURI”; Preferred label changed from “Local REST API with MCP@en” to “Advanced URI@en”; Definition updated; Scope note updated (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin .

