# Python (build tooling is invoked ad hoc; no package lives here)
.venv/
__pycache__/

# macOS
.DS_Store

*.bak
*.bak.ttl

# Validation output, regenerated by `make check`
reports/

# Generated artifacts, rebuilt by `make models artifacts`
generated/

# Personal permission rules for this checkout; not repository policy
.claude/settings.local.json
