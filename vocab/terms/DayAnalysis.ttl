pkmv:DayAnalysis a skos:Concept ;
    dcterms:created "2026-08-24"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterCore ;
    skos:broader pkmv:DayClusterCore ;
    skos:definition "Overall analytical synthesis of a day across domains."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Analysis"@en ;
    skos:scopeNote """- Includes Plus-Minus-Next analysis: overall, health, learning, and work.
- Generated by Claude AI during Morning Review workflow as a final report for the previous day.
- Compares DayPlan intentions and actual DayLog activities."""@en .

