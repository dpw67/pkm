@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:WeekCollection skos:member pkmv:WeekReview .

pkmv:WeekReview a skos:Concept ;
    rdfs:label "Week Review"@en ;
    dcterms:created "2026-08-24"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:WeekCluster ;
    skos:broader pkmv:WeekCluster ;
    skos:definition "A structured retrospective evaluating a compled week"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Week Review"@en ;
    skos:scopeNote "Assesses the week against the WeekPlan."@en .

