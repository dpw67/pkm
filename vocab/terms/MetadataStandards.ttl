@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MetadataStandards a skos:Concept ;
    rdfs:label "Metadata Standards"@en ;
    dcterms:created "2026-09-19"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    skos:altLabel "Metadata Schema"@en ;
    skos:broader pkmv:OntologyPipeline ;
    skos:definition "Characteristics or attributes of data are defined as properties and/or operations (methods or functions) for a common understanding of detail information with common names, data types, and allowed values, as well as relations to other objects."@en ;
    skos:editorialNote """The PKM namespace uses standard vocabularies and metadata from multiple standards:
- Dublin Core metadata (`dcterms`)
- SKOS (`skos`): schemes, concepts, and collections
- ISO 25964 (`isothes`): Thesaurus relations
- RDF Schema (`rdfs`): Resource Description Framework
- OWL (`owl`): Web Ontology Language
- FOAF (`foaf`): Linked Data — people and information (originally, "Friend of a Friend" from social web)
- Schema.org (`schema`): Standard web schemas
- Provenance(`prov`)"""@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:DublinCore ;
    skos:prefLabel "Metadata Standards"@en ;
    skos:scopeNote """- Metadata is simply data about data. Metadata elements provide shared context and meaning; they are typically categorized as structural (machine readability), descriptive (for context), and administrative (for maintenance and lineage).
- Using standards for metadata schema helps to provide consistency and common semantics for metadata properties for concepts and relationships."""@en .

