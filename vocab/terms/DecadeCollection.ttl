@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:DecadeCollection a skos:Collection ;
    rdfs:label "Decade Collection"@en ;
    skos:member pkmv:Decade ;
    skos:note "All notes related to a ten-Year span used for long-range life planning."@en .

