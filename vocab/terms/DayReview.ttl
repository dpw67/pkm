@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCollection skos:member pkmv:DayReview .

pkmv:DayReview a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterCore ;
    skos:broader pkmv:DayClusterCore ;
    skos:definition "A structured retrospective evaluating a completed day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Review"@en ;
    skos:scopeNote """- Output of the Morning Review workflow: assesses the prior day against the Day Plan.
- Includes Plus-Minus-Next (PMN) analysis: what worked, what needs improving, and what's next."""@en .

