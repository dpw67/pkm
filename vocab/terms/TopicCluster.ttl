@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:TopicCluster a skos:Concept ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:Cluster ;
    skos:definition "A group of related notes about a topic.."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:TopicIndex,
        pkmv:TopicJournal,
        pkmv:TopicLog,
        pkmv:TopicPlan,
        pkmv:TopicReview ;
    skos:prefLabel "Topic Cluster"@en ;
    skos:scopeNote "Parent context for all notes associated with a topic."@en .

