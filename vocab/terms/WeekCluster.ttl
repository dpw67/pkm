@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:WeekCluster a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:TimeCluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:WeekAnalysis,
        pkmv:WeekDiabetes,
        pkmv:WeekDiabetesAnalysis,
        pkmv:WeekHealth,
        pkmv:WeekIndex,
        pkmv:WeekJournal,
        pkmv:WeekLog,
        pkmv:WeekMealPlan,
        pkmv:WeekPlan,
        pkmv:WeekReview ;
    skos:broader pkmv:CalendarFolder,
        pkmv:TimeCluster ;
    skos:definition "The set of structured notes and artifacts generated for a single week, aggregating and analyzing its constituent Day Clusters."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:WeekAnalysis,
        pkmv:WeekDiabetes,
        pkmv:WeekDiabetesAnalysis,
        pkmv:WeekHealth,
        pkmv:WeekIndex,
        pkmv:WeekJournal,
        pkmv:WeekLog,
        pkmv:WeekMealPlan,
        pkmv:WeekPlan,
        pkmv:WeekReview ;
    skos:prefLabel "Week Cluster"@en ;
    skos:scopeNote "Sits above DayCluster and below Month in the Calendar hierarchy; narrower concepts include WeekIndex, WeekAnalysis, WeekMealPlan, WeekDiabetes, and WeekHealth."@en .

