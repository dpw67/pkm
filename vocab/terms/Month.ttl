@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MonthCollection skos:member pkmv:Month .

pkmv:Month a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-27"^^xsd:date ;
    isothes:broaderPartitive pkmv:Calendar ;
    skos:broader pkmv:Calendar ;
    skos:definition "A calendar month grouping weeks and days."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Month"@en ;
    skos:related pkmv:MonthCluster ;
    skos:scopeNote """- Contains lower time horizons via IN_MONTH: parent horizon for monthly planning and review artifacts. 
- Each month contains multiple multiple weeks (4-5) and days (28-31).
- There are 3 months in a quarter, and 12 months in a year."""@en .

