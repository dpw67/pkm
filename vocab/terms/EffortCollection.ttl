@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:EffortCollection a skos:Collection ;
    rdfs:label "Effort Collection"@en ;
    skos:member pkmv:Area,
        pkmv:EffortCluster,
        pkmv:EffortsFolder,
        pkmv:Interest,
        pkmv:Project ;
    skos:note "All the related notes for a single Effort."@en .

