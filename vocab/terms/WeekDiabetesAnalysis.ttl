pkmv:WeekDiabetesAnalysis a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:WeekCluster ;
    skos:broader pkmv:WeekCluster ;
    skos:definition "A note summarizing patterns or trends in diabetes-related tracked data (e.g. glucose, insulin) across a week."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Week Diabetes Analysis"@en ;
    skos:scopeNote "Narrower than WeekAnalysis and WeekDiabetes - the analytical output specific to diabetes data, tied to the Diabetes AI Coach project."@en .

