@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCollection skos:member pkmv:DayClusterVisual .

pkmv:DayClusterVisual a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayCluster ;
    isothes:narrowerPartitive pkmv:DayBase,
        pkmv:DayBoard,
        pkmv:DayCanvas,
        pkmv:DayDiagram,
        pkmv:DayDrawing,
        pkmv:DayMindmap,
        pkmv:DayView ;
    skos:broader pkmv:DayCluster ;
    skos:definition "The visual tools and generated diagrams associated with a Day Cluster, used to represent the day's structure or data graphically."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:DayBase,
        pkmv:DayBoard,
        pkmv:DayCanvas,
        pkmv:DayDiagram,
        pkmv:DayDrawing,
        pkmv:DayMindmap,
        pkmv:DayView ;
    skos:prefLabel "Day Cluster Visual"@en ;
    skos:scopeNote "The day-cluster generator's visual output; distinct from the textual notes in DayClusterCore/Support/Health."@en .

