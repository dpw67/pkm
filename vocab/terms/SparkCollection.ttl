@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:SparkCollection a skos:Collection ;
    rdfs:label "Spark Collection"@en ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Idea,
        pkmv:Spark ;
    skos:note "Idea and Spark, the two concepts for something newly noticed and not yet developed. Two members, and no narrower concepts beneath either, so the grouping is not yet doing work."@en ;
    skos:prefLabel "Spark Collection"@en .

