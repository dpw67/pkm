@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortCollection skos:member pkmv:EffortsFolder .

pkmv:EffortsFolder a skos:Concept ;
    rdfs:label "Efforts Folder"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    isothes:narrowerGeneric pkmv:Action,
        pkmv:Area,
        pkmv:Interest,
        pkmv:Project ;
    skos:altLabel "Effort Folder"@en ;
    skos:broader pkmv:Vault ;
    skos:definition "A unit of directed work toward an outcome, such as a project or initiative."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Action,
        pkmv:Area,
        pkmv:Interest,
        pkmv:Project ;
    skos:prefLabel "Efforts Folder"@en ;
    skos:scopeNote "Groups activity by goal; the intent behind logged actions."@en .

