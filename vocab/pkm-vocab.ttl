pkma:Claude-AI a prov:SoftwareAgent ;
    foaf:homepage <https://claude.ai> ;
    foaf:name "Claude AI LLM (Sonnet/Opus models)" .

pkma:Jessica-Talisman a prov:Person ;
    foaf:homepage <https://www.ontologypipeline.com> ;
    foaf:name "Jessica Talisman" .

pkma:SKOS-Editor a prov:SoftwareAgent ;
    foaf:homepage <https://github.com/jesstalisman-ia/intentional-arrangement-skos> ;
    foaf:name "SKOS Editor" .

pkmr:PKM-URI-Namespace a foaf:Document ;
    dcterms:title "PKM URI Namespace (https://w3id.org/pkm)"@en ;
    rdfs:comment "Persistent URI namespace for Personal Knowledge Management (PKM) and Knowledge System Architecture (KSA). This includes glossary (terms), taxonomy (concepts, hierarchy, related, etc.), thesaurus, ontology (classes, individuals, properties, relations, rules), knowledge graph (nodes, relationships, properties, queries), metadata schema (JSON, CSV, etc,), tools (Python, Swift, Cypher, SQL, etc.), and resources (website, notes, repositories, etc.)."@en ;
    foaf:page <https://w3id.org/pkm> .

pkmr:RDF-Ontology-Glossary a foaf:Document ;
    dcterms:title "RDF/RDFS Ontology Glossary"@en ;
    rdfs:comment "Substack essay on Ontology Part IV including link to download an abbreviated Ontology Glossary."@en ;
    foaf:page <https://jessicatalisman.substack.com/p/ontology-glossary> .

pkmr:RDF-Ontology-Glossary-Abbreviated a foaf:Document ;
    dcterms:title "RDF/RDFS Ontology Glossary (Abbreviated)"@en ;
    rdfs:comment "A 6-page abbreviated RDF Ontology Glossary available as a downloadable PDF document."@en ;
    foaf:page <https://jessicatalisman.substack.com/api/v1/file/75abcfc1-acec-4f9c-aeb2-6a27d455ffd5.pdf> .

pkmv:ACEOrganization a skos:Concept ;
    rdfs:label "ACE Organization"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    dcterms:source pkmr:ACE-Organization ;
    skos:altLabel "ACE Folders"@en ;
    skos:broader pkmv:Ideaverse ;
    skos:changeNote "2026-08-29 — Duplicated from “Ideaverse” (by Doug Warren)"@en,
        "2026-08-29 — Parent “Ideaverse” added; Parent “Vault” removed (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “IdeaverseCopy” to “ACEOrganization”; Preferred label changed from “Ideaverse@en” to “ACE Organization@en”; Alternative label “ACE Folders@en” added; Definition updated (by Doug Warren)"@en,
        "Added definition and scope notes for ACE Organization."@en ;
    skos:definition "The folders of Atlas, Calendar, and Efforts organizes our thinking in an Obsidian vault based on Ideaverse."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "ACE Organization"@en ;
    skos:scopeNote "- Frameworks and methodology recommended by Nick Milo and Linking Your Thinking (LYT) for linked note systems like Obsidian."@en .

pkmv:ARCIdeation a skos:Concept ;
    rdfs:label "ARC Ideation"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    dcterms:source pkmr:ACE-Organization ;
    skos:altLabel "ARC Framework"@en ;
    skos:broader pkmv:Ideaverse ;
    skos:changeNote "2026-08-29 — Duplicated from “ACE Organization” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “ACEOrganizationCopy” to “ARCIdeation”; Preferred label changed from “ACE Organization@en” to “ARC Ideation@en”; Alternative label “ARC Framework@en” added; Alternative label “ACE Folders@en” removed; Definition updated (by Doug Warren)"@en,
        "Added definition and scope notes for ARC Ideation."@en ;
    skos:definition "The stages for the natural flow of ideas in the creative process (Add, Related, Communicate)."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "ARC Ideation"@en ;
    skos:scopeNote "- Frameworks and methodology recommended by Nick Milo and Linking Your Thinking (LYT) for linked note systems like Obsidian."@en .

pkmv:AdvancedURI a skos:Concept ;
    rdfs:label "Advanced URI"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin ;
    skos:changeNote "2026-08-29 — Duplicated from “Local REST API with MCP” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “LocalRESTAPIWithMCPCopy” to “AdvancedURI”; Preferred label changed from “Local REST API with MCP@en” to “Advanced URI@en”; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Advanced URI."@en ;
    skos:definition "Control Obsidian features using special URIs to automate workflows."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Advanced URI"@en ;
    skos:scopeNote """- Open files, workspacces, headlngs, blocks, lines, and settings.
- Open files in tabs, splits, windows, popovers, or silently in the background.
- Switch between reading, source, and live preview mode.
- Edit, overwrite, append, prepend, and create files.
- Append or prepend content to specific heading, block, or line.
- Write clipboard contents to notes, including daily notes.
- Open bookmarks.
- Automated search and replace, including regular expressions.
- Call Obsidian and plugin commands.
- Edit, read, and focus frontmatter properties
- Navigate using file paths, file names, aliases, daily notes, or frontmatter UIDs
- Create robust persistent IDs in properties that keep working when notes are renamed or moved.
"""@en .

pkmv:AppleHealth a skos:Concept ;
    rdfs:label "Apple Health"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:HealthData ;
    skos:changeNote "2026-08-29 — Duplicated from “Dexcom Data” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “DexcomDataCopy” to “AppleHealth”; Preferred label changed from “Dexcom Data@en” to “Apple Health@en”; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Apple Health."@en ;
    skos:definition "Health data from Apple Health via the HealthKit framework."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Apple Health"@en ;
    skos:scopeNote "- Includes data from Apple Health."@en .

pkmv:Base a skos:Concept ;
    rdfs:label "Base"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianNotes ;
    skos:changeNote "2026-08-29 — Duplicated from “Note” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “NoteCopy” to “Base”; Preferred label changed from “Note@en” to “Base@en”; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for a Base."@en ;
    skos:definition "A database with table, grid, or list views of a collection of notes with selected properties and formulas with associated query filters, group, and sort criteria.."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Base"@en ;
    skos:scopeNote """- Provides multiple views with different query crtieria, which can be selected as embedded bases in view or canvas notes.
- Enables CSV export from a base for integration with other apps such as Neo4j as well as Swift and Python apps, services, scripts, commands, or agents."""@en .

pkmv:Bases a skos:Concept ;
    rdfs:label "Bases"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin ;
    skos:changeNote "2026-08-29 — Duplicated from “Periodic Notes” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “PeriodicNotesCopy” to “Bases”; Preferred label changed from “Periodic Notes@en” to “Bases@en”; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Bases."@en ;
    skos:definition "A core plugin thatcreates custom views to edit, sort, and filter files using properties."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Bases"@en ;
    skos:scopeNote """- Used for frequent or common views of notes with properties.
- Helpful for metadata management of properties.
- Enables CSV export of notes and properties."""@en .

pkmv:Book a skos:Concept ;
    rdfs:label "Book"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:Source ;
    skos:changeNote "2026-08-29 — Duplicated from “Source” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “SourceCopy” to “Book”; Preferred label changed from “Source@en” to “Book@en”; Definition updated; Scope note updated; Parent “Source” added; Parent “Knowledge” removed (by Doug Warren)"@en,
        "2026-08-29 — relatedMatch https://schema.org/Book added (by Doug Warren)"@en,
        "Added definition and scope notes for a Book."@en ;
    skos:definition "A book used as a source in a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Book"@en ;
    skos:relatedMatch schema:Book ;
    skos:scopeNote """- Includes properties about the book, author, publisher, etc.
- Created with a Book Template, and metadata captured by the Obsidian Book Search plugin.
- Query book using book title, author, publisher, or ISBN
- Uses Google Books API to get the book information and cover image for the Book note.
- Includes properties for title, subtitle, authors, categories, description, publisher, total pages, cover URL small cover URL, local cover image, publishDate, and ISBN."""@en .

pkmv:BookSearch a skos:Concept ;
    rdfs:label "Book Search"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin ;
    skos:changeNote "2026-08-29 — Renamed from “NewConcept” to “BookSearch”; Preferred label “Book Search@en” added; Definition added; Scope note added (by Doug Warren)"@en,
        "2026-08-29 — Term created under “Obsidian Plugin” (by Doug Warren)"@en,
        "Added definition and scope notes for Book Search."@en ;
    skos:definition "Query book by title, author, publisher, or ISBN, and get book information via Google Books API for properties."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Book Search"@en ;
    skos:scopeNote "Simplifies creation of Book notes by downloading relevant properties and cover image."@en .

pkmv:Canvas a skos:Concept ;
    rdfs:label "Canvas"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
