/// Loads a fixture into a context.
public struct {{ module }}Importer {

    public let context: ModelContext

    public init(context: ModelContext) {
        self.context = context
    }

    /// Store every record in the fixture, then save.
    ///
    /// The order is {{ model.load_order | map(attribute="name") | join(", then ") }} -- read off the
    /// schema, not chosen. A reference cannot be resolved before the record it
    /// points at exists.
    public func load(_ fixture: {{ module }}Fixture) throws {
{% for shape in model.load_order %}
        try {{ shape.name }}Repository(context: context).upsert(fixture.{{ shape.name | plural }})
{% endfor %}
        try context.save()
    }
}
