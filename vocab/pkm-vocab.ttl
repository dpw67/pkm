        pkmr:RDF-Ontology-Glossary-Abbreviated ;
    isothes:broaderPartitive pkmv:Knowledge ;
    rdfs:seeAlso skos:Concept ;
    skos:broader pkmv:Knowledge ;
    skos:changeNote "2026-08-24 — Definition added; Scope note added; Linked artifact “skos:Concept” added (by Doug Warren)"@en,
        "2026-08-29 — Unmarked as a top concept; Parent “Knowledge” added (by Doug Warren)"@en,
        "2026-08-31 — Linked artifact “SKOS Concept” added; Linked artifact “SKOS Concept” removed (by Doug Warren)"@en,
        "Added definition and scope notes for Concept."@en ;
    skos:definition "A unit of thought in a knowledge organization system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Concept"@en ;
    skos:related pkmv:Term ;
    skos:scopeNote "An abstract idea independent of its label. It's how we organize ideas for browsing and retrieval. a PKM Concept is based on the SKOS standard skos:Concept."@en .

pkmv:KnowledgeGraph a skos:Concept ;
    rdfs:label "Knowledge Graph"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:GraphDatabase ;
    skos:broader pkmv:GraphDatabase,
        pkmv:KnowledgeSystem ;
    skos:changeNote "2026-08-28 — Definition added; Scope note added (by Doug Warren)"@en,
        "2026-08-29 — Unmarked as a top concept; Parent “Knowledge System” added (by Doug Warren)"@en,
        "Add missing definition and scope notes as initial placeholder content to review refine, and evolve further."@en ;
    skos:definition "A structured network of entities (nodes) and their relationships (edges), typically machine-readable, used to represent and query interconnected knowledge."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Knowledge Graph"@en ;
    skos:scopeNote "Refers specifically to the Neo4j graph instance mirroring and linking PKM notes and health events. Distinguish from Ontology (schema) and Taxonomy (classificatory hierarchy) - this is the populated data instance."@en .

pkmv:PythonTemplate a skos:Concept ;
    rdfs:label "Python Template"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:Tool ;
    isothes:broaderPartitive pkmv:ObsidianNotes ;
    skos:broader pkmv:ObsidianNotes,
        pkmv:PKMPython,
        pkmv:Tool ;
    skos:changeNote "2026-08-28 — Unmarked as a top concept; Parent “Tool” added (by Doug Warren)"@en,
        "2026-08-29 — Definition added; Scope note added (by Doug Warren)"@en,
        "2026-08-29 — Parent “Obsidian” added (by Doug Warren)"@en,
        "2026-08-29 — Parent “PKM Python” added; Parent “Template” removed (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “Template” to “PythonTemplate”; Preferred label changed from “Template@en” to “Python Template@en”; Definition updated; Scope note updated; Parent “Template” added; Parent “Tool” removed; Parent “Obsidian” removed (by Doug Warren)"@en,
        "2026-08-29 — Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Python Template."@en ;
    skos:definition "A Python (Jinja2) template determines the structure, layout, and configuration for various types of notes in the PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Python Template"@en ;
    skos:scopeNote """- Includes PKM Python template system using Jinja2 templates with Mustache syntax (`{{ ... }}`) that are used to generate Obsidian notes from Python (and/or Swift) services, scripts, commands, and agents.
- Distinguished from templates created with the Obsidian Templater plugin, with optional inline Templater expressions (`<% ... %>`) and JavaScript code."""@en .

