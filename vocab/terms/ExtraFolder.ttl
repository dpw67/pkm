pkmv:ExtraFolder a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    skos:altLabel "Support Folder"@en ;
    skos:broader pkmv:Vault ;
    skos:definition "The top-level `x` folder space in Obsidian includes Extra or Support resources."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Extra Folder"@en ;
    skos:scopeNote """- This includes infrastructure like.templates (using Obsidian Templater plugin), images, documents, scripts, etc.
- It does not include knowledge content itself."""@en .

