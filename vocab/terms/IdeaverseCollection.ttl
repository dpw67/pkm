@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:IdeaverseCollection a skos:Collection ;
    rdfs:label "Ideaverse Collection"@en ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:ObsidianNotes,
        pkmv:Vault ;
    skos:note "The vault as a whole and the notes inside it. Two members naming the container rather than its contents, which is a different job from every other collection here."@en ;
    skos:prefLabel "Ideaverse Collection"@en .

