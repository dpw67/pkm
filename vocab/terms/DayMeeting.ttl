@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayMeeting a skos:Concept ;
    rdfs:label "Day Meeting"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-10"^^xsd:date ;
    skos:broader pkmv:DayClusterSupport ;
    skos:definition "An event with attendees, agenda, topics, decisions, and actions."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Meeting"@en ;
    skos:scopeNote "Records what happened with a meeting event on a specific day, what's next, and who does what and when."@en .

