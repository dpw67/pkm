pkmv:EffortIndex a skos:Concept ;
    rdfs:label "Effort Index"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:EffortCluster ;
    skos:definition "The index note that links all artifacts for an effort."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Effort Index"@en ;
    skos:scopeNote "Hub note connecting EffortPlan, EffortLog, EffortJournal, EffortReview, and related notes for an Effort."@en .

