@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:ConceptCollection a skos:Collection ;
    rdfs:label "Concept Collection"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Concept,
        pkmv:Cypher,
        pkmv:KnowledgeGraph,
        pkmv:Metadata,
        pkmv:OWL,
        pkmv:Ontology,
        pkmv:RDF,
        pkmv:SKOS,
        pkmv:Taxonomy,
        pkmv:Term ;
    skos:note "The languages, standards and artifacts a concept is expressed in, rather than notes about any one concept. Cuts across the hierarchy instead of following it."@en ;
    skos:prefLabel "Concept Collection"@en .

