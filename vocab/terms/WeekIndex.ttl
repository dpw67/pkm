@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:WeekCollection skos:member pkmv:WeekIndex .

pkmv:WeekIndex a skos:Concept ;
    rdfs:label "Week Index"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:WeekCluster ;
    skos:broader pkmv:WeekCluster ;
    skos:definition "A hub note for a given week that links to and organizes its constituent Day Cluster notes and other weekly artifacts."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Week Index"@en ;
    skos:scopeNote "Navigational role within WeekCluster, analogous to the Index hub notes in the Effort/Output Cluster design."@en .

