@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ControlledVocabulary a skos:Concept ;
    rdfs:label "Controlled Vocabulary"@en ;
    dcterms:created "2026-09-19"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    skos:altLabel "Vocabulary"@en ;
    skos:broader pkmv:OntologyPipeline ;
    skos:definition "A curated collection of concepts, labels, definitions, and relations with other concepts."@en ;
    skos:editorialNote "In \"Domain-Driven Design\", Eric Evans calls this \"Ubiquitous Language\" when designing a domain model for software architecture that provides common knowledge between people (domain experts and developers) and systems (apps, services, and agents) about what objects know and do."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Controlled Vocabulary"@en ;
    skos:scopeNote "Establishes shared understanding of what certain words and phrases mean in a specific context."@en .

