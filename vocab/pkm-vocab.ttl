    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:Decade,
        pkmv:Month,
        pkmv:Quarter,
        pkmv:Time,
        pkmv:Week,
        pkmv:Year ;
    skos:broader pkmv:CalendarFolder ;
    skos:changeNote "2026-08-25 — Created from approved proposal (proposed by Doug Warren) (by Doug Warren)"@en,
        "2026-08-26 — Definition updated; Scope note updated (by Doug Warren)"@en,
        "2026-08-26 — Scope note updated (by Doug Warren)"@en,
        "2026-08-29 — Unmarked as a top concept; Parent “Calendar Folder” added (by Doug Warren)"@en,
        "Removed redundant Calendar2 created by Proposals tab when it already existed."@en ;
    skos:definition "A major space for time-based notes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Day,
        pkmv:Decade,
        pkmv:Month,
        pkmv:Quarter,
        pkmv:Time,
        pkmv:Week,
        pkmv:Year ;
    skos:prefLabel "Calendar"@en ;
    skos:scopeNote """- Scheduled events and sessions for time periods: Day, Week, Quarter, and Year.
- Parent context for clusters of notes by time horizon.
- Calendar is a major space for time-based linked notes in Obsidian Ideaverse vault in a PKM system, as well as a synced Neo4j subgraph within a PKM knowledge graph.
- Supported by API routes, Python services, scripts, and agents, as well as Swift apps, intents, widgets, shortcuts, and Siri.
- Also represented by Calendar and Fantastical apps."""@en .

