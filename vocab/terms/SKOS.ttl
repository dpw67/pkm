@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ConceptCollection skos:member pkmv:SKOS .

pkmv:SemanticWebStandards skos:member pkmv:SKOS .

pkmv:SKOS a skos:Concept ;
    rdfs:label "SKOS"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:Standard ;
    skos:broader pkmv:Standard,
        pkmv:W3CStandard ;
    skos:definition "Simple Knowledge Organization System - a W3C standard data model, expressed in RDF, for representing controlled vocabularies such as thesauri, taxonomies, and classification schemes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "SKOS"@en ;
    skos:scopeNote "The core standard underpinning this vocabulary and the SKOS Editor tool itself; concepts, schemes, and relationships here are all expressed using SKOS."@en .

