pkmv:Life a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:Area ;
    skos:definition "The full lifespan, the top temporal (time) horizon."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Life"@en ;
    skos:scopeNote """- Root of the Calendar subgraph via IN_LIFE: frames lifelong goals and identity-level context.
- An area that includes your entire lifespan."""@en .

