@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:OntologyPipeline a skos:Concept ;
    rdfs:label "Ontology Pipeline"@en ;
    dcterms:created "2026-09-19"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    rdfs:seeAlso <https://www.amazon.com/Ontology-Pipeline-Framework-Knowledge-Engineering/dp/B0HJ9223FH> ;
    skos:broader pkmv:SemanticKnowledgeManagementSystem ;
    skos:definition "A framework for knowledge management engineering."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:ControlledVocabulary,
        pkmv:MetadataStandards ;
    skos:prefLabel "Ontology Pipeline"@en ;
    skos:scopeNote """- Described by Jessica Talisman in her book "Ontology Pipeline: A Framework for Knowledge Management Engineering".
- Includes controlled vocabulary, metadata standards, taxonomy, thesaurus, ontology, and knowledge graphs."""@en .

