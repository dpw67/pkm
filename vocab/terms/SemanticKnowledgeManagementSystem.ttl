@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:SemanticKnowledgeManagementSystem a skos:Concept ;
    rdfs:label "Semantic Knowledge Management System"@en ;
    dcterms:created "2026-09-19"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    rdfs:seeAlso <https://www.amazon.com/Ontology-Pipeline-Framework-Knowledge-Engineering/dp/B0HJ9223FH> ;
    skos:altLabel "SKMS"@en ;
    skos:definition "A framework for an organized structure of concepts, definitions, and relationships for consistent knowledge, context, and memory usage by both humans and agents."@en ;
    skos:editorialNote "New top concept for general information about knowledge systems, standards, semantic web, and ontology pipeline methodology."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:OntologyPipeline ;
    skos:prefLabel "Semantic Knowledge Management System"@en ;
    skos:scopeNote """Reflects the process, stages, methodology, and workflows described by Jessica Talisman in her book on the "Ontology Pipeline": controlled vocabulary, taxonomy, metadata standards (schemas), thesaurus, ontology, and knowledge graph.

Distinguished from:
- Personal Knowledge Management (PKM) with generic principles and practices
- Knowledge System Architecture (KSA) for a specific implementation
- Concept Spaces (Ideaverse) with notes about concepts organized by Knowledge, Time, and Action
- Technical Stack (or "Technology Foundation") with instances of products, apps, services, and tools"""@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

