@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortCollection skos:member pkmv:EffortsFolder .

pkmv:EffortsFolder a skos:Concept ;
    rdfs:label "Efforts Folder"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-09-19"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    isothes:narrowerGeneric pkmv:Action,
        pkmv:Area,
        pkmv:Interest,
        pkmv:Project ;
    skos:altLabel "Effort Folder"@en ;
    skos:broader pkmv:Vault ;
    skos:definition "A major space within an Obsidian vault containing notes about action (\"what you do\"), holding efforts such as areas, interests, and projects."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Action,
        pkmv:Area,
        pkmv:Interest,
        pkmv:Project ;
    skos:prefLabel "Efforts Folder"@en ;
    skos:scopeNote "Notes about procedural knowledge, process workflows, periodic routines, regular practices, skills, and activities — \"what you do and how it's done\". Distinguished from Atlas Folder about knowledge (\"what you know\"), or Calendar Folder with time-based notes (\"when events happened or you did something\")."@en .

