@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ConceptCollection skos:member pkmv:Metadata .

pkmv:SemanticWebStandards skos:member pkmv:Metadata .

pkmv:Metadata a skos:Concept ;
    rdfs:label "Metadata"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem ;
    skos:definition "Structured data that describes, identifies, or provides context for another resource, such as a note, concept, or file."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Metadata"@en ;
    skos:scopeNote "Covers Obsidian YAML frontmatter properties, SKOS annotation properties, and similar descriptive attributes. Does not cover the content/body of a resource itself."@en .

