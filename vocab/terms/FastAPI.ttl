@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:TechStack skos:member pkmv:FastAPI .

pkmv:FastAPI a skos:Concept ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:Tool ;
    skos:broader pkmv:PKMPythonAPI,
        pkmv:Tool ;
    skos:definition "A modern, high-performance Python web framework for building APIs."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "FastAPI"@en ;
    skos:scopeNote "The framework underlying pkm-neo4j-service, which exposes the Neo4j knowledge graph as an API."@en .

