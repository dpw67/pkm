{
  "@context": {
    "@version": 1.1,

    "pkm":     "https://w3id.org/pkm/ontology#",
    "pkmv":    "https://w3id.org/pkm/vocab/",
    "dcterms": "http://purl.org/dc/terms/",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "skos":    "http://www.w3.org/2004/02/skos/core#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",

    "id":    "@id",
    "type":  "@type",

    "Note":       "pkm:Note",
    "Tag":        "pkm:Tag",
    "Source":     "pkm:Source",

    "title":      { "@id": "dcterms:title" },
    "created":    { "@id": "dcterms:created", "@type": "xsd:dateTime" },
    "modified":   { "@id": "dcterms:modified", "@type": "xsd:dateTime" },
    "label":      { "@id": "rdfs:label", "@language": "en" },

    "linksTo":    { "@id": "pkm:linksTo",   "@type": "@id", "@container": "@set" },
    "hasTag":     { "@id": "pkm:hasTag",    "@type": "@id", "@container": "@set" },
    "derivedFrom":{ "@id": "pkm:derivedFrom", "@type": "@id" }
  }
}
