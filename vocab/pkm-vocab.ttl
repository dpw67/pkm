pkmv:DayJournal a skos:Concept ;
    rdfs:label "Day Journal"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterCore ;
    skos:broader pkmv:DayClusterCore ;
    skos:changeNote "2026-08-25 — Created from approved proposal (proposed by Doug Warren) (by Doug Warren)"@en,
        "2026-08-27 — Parent “Day Cluster” added (by Doug Warren)"@en,
        "2026-08-27 — Renamed from “DayJournal2” to “DayJournal”; Preferred label changed from “DayJournal@en” to “Day Journal@en”; Parent “Day Cluster” removed (by Doug Warren)"@en,
        "2026-08-28 — Parent “Day Cluster Core” added; Parent “Day Cluster” removed (by Doug Warren)"@en,
        "Added definition and scope notes to DayJournal. Removed redundant DayJournal2 generated by Proposals when already exists."@en ;
    skos:definition "Free-form reflective writing about a day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Journal"@en ;
    skos:scopeNote """- Subjective narrative and reflection: complements the factual DayLog. 
- Includes Morning Thoughts (First Light), Meditation with reflection and moods, Free-writing, Interstitial journaling between sessions or activities, and Evening Thoughts (Last Light).
- Primarily formatted as text paragraphs and/or headings as appropriate; whereas DayLog is typically timestamped bullet or numbered lists rather than written paragraphs."""@en .

