@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:NoteTypes skos:member pkmv:Spark .

pkmv:SparkCollection skos:member pkmv:Spark .

pkmv:Spark a skos:Concept ;
    rdfs:label "Spark"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:AddFolder ;
    skos:broader pkmv:AddFolder ;
    skos:definition "A brief, informal capture of an idea, prompt, or stimulus intended for later development."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Spark"@en ;
    skos:scopeNote "A PKM quick-capture note type sibling to Idea/Draft/Clipping. This is not intended as the open-source technology tool called Apache Spark (data processing)."@en .

