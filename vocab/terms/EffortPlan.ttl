@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortPlan a skos:Concept ;
    rdfs:label "Effort Plan"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    skos:broader pkmv:EffortCluster ;
    skos:definition "The plan of intended activities and priorities for an effort."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Effort Plan"@en ;
    skos:scopeNote "Forward-looking: created for the effort, distinct from the retrospective EffortReview."@en .

