pkmv:IdeaEmergence a skos:Concept ;
    rdfs:label "Idea Emergence"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-31"^^xsd:date ;
    dcterms:source pkmr:ACE-Organization ;
    skos:broader pkmv:Ideaverse ;
    skos:changeNote "2026-08-29 — Duplicated from “ARC Ideation” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “ARCIdeationCopy” to “IdeaEmergence”; Preferred label changed from “ARC Ideation@en” to “Idea Emergence@en”; Alternative label “ARC Framework@en” removed; Definition updated; Scope note updated (by Doug Warren)"@en,
        "2026-08-31 — Definition updated (by Doug Warren)"@en,
        "Added definition and scope notes for Idea Emergence."@en ;
    skos:definition "The process of how ideas you encounter go from \"nothingness to somethingness\", and how they grow in richness, complexity, and meaning over time."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Idea Emergence"@en ;
    skos:scopeNote "- Process and methodology recommended by Nick Milo and Linking Your Thinking (LYT) for linked note systems like Obsidian."@en .

pkmv:LocalRESTAPIWithMCP a skos:Concept ;
    rdfs:label "Local REST API with MCP"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianPlugin ;
    skos:changeNote "2026-08-29 — Duplicated from “Periodic Notes” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “PeriodicNotesCopy” to “LocalRESTAPIWithMCP”; Preferred label changed from “Periodic Notes@en” to “Local REST API with MCP@en”; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for Local REST API with MCP."@en ;
    skos:definition "Support automation for notes using REST API for apps or MCP server for AI agents."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Local REST API with MCP"@en ;
    skos:scopeNote """- Enable Obsidian functions for Claude Desktop or Claude Code, Cursor, and other MCP clients such as Python services, scripts, or agents.
- Create, read, update, or delete notes.
- Patch specific sections of notes by heading, block, or frontmatter properties.
- Search you vault using full-text or JsonLogic queries against note metadata (frontmatter, tags, path, or content).
- Access the active Obsidian file.
- List and execute commands.
- Query tags.
- Open files in Obsidian user interface."""@en .

pkmv:Map a skos:Concept ;
    rdfs:label "Map"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:altLabel "MOC"@en,
        "Map of Content"@en ;
    skos:broader pkmv:ObsidianNotes ;
    skos:changeNote "2026-08-29 — Duplicated from “Note” (by Doug Warren)"@en,
        "2026-08-29 — Renamed from “NoteCopy” to “Map”; Preferred label changed from “Note@en” to “Map@en”; Alternative label “Map of Content@en” added; Alternative label “MOC@en” added; Definition updated; Scope note updated (by Doug Warren)"@en,
        "Added definition and scope notes for a Map."@en ;
    skos:definition "A note used to think, plan, and organize a group of other notes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Map"@en ;
    skos:scopeNote """- It might begin as an index or hub note for a collectio of other related notes.
- This typically evolves into a more structured map by collecting links into related groups, adding headings to establish more organization, and additional commentary to provide more context and information.
- Connected with other maps in a network to provide organization and navigation for the linked notes in a PKM system."""@en .

