@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:MonthCollection a skos:Collection ;
    rdfs:label "Month Collection"@en ;
    skos:member pkmv:Month,
        pkmv:MonthJournal,
        pkmv:MonthLog,
        pkmv:MonthPlan,
        pkmv:MonthReview ;
    skos:note "All related notes for a calendar month grouping Weeks and Days."@en .

