pkmv:AtlasFolder a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Atlas Folder"@en ;
    rdfs:label "Atlas Folder"@en ;
    skos:altLabel "Knowledge Folder"@en ;
    skos:definition "A major space within an Obsidian vault containing notes about knowledge (\"what you know\")."@en ;
    skos:scopeNote "- Distinguishes notes for Knowledge (Atlas) from those about Time (Calendar) or Action (Efforts) in the Ideaverse ACE organization framework by Nick Milo and Linking Your Thinking (LYT).\n- Additional spaces in an Ideaverse vault provide infrastructure with the + Folder (Add / Plus) as the Obsidian \"inbox\", x Folder (Extra / Support), and z Folder (Archive)."@en ;
    skos:changeNote "Added definition and scope notes for Knowledge Folder."@en, "2026-08-29 — Term created under “Knowledge” (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “KnowledgeFolder”; Preferred label “Knowledge Folder@en” added; Alternative label “Atlas Folder@en” added; Definition added; Scope note added; Parent “Vault” added (by Doug Warren)", "2026-08-29 — Parent “Knowledge” removed (by Doug Warren)", "2026-08-29 — Renamed from “KnowledgeFolder” to “AtlasFolder”; Preferred label changed from “Knowledge Folder@en” to “Atlas Folder@en”; Alternative label “Knowledge Folder@en” added; Alternative label “Atlas Folder@en” removed (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    skos:broader pkmv:Vault .

