@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:CalendarFolder a skos:Concept ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    isothes:narrowerPartitive pkmv:Calendar,
        pkmv:DayCluster,
        pkmv:MonthCluster,
        pkmv:QuarterCluster,
        pkmv:TimeCluster,
        pkmv:WeekCluster,
        pkmv:YearCluster ;
    skos:altLabel "Time Folder"@en ;
    skos:broader pkmv:Vault ;
    skos:definition "The Calendar (Time) folder is the PKM knowledge space for time-based notes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Calendar,
        pkmv:DayCluster,
        pkmv:MonthCluster,
        pkmv:QuarterCluster,
        pkmv:TimeCluster,
        pkmv:WeekCluster,
        pkmv:YearCluster ;
    skos:prefLabel "Calendar Folder"@en ;
    skos:scopeNote "- Includes time clusters: Day, Week, Month, Quarter, Year, Decade, and Life."@en .

