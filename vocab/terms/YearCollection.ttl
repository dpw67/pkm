@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:YearCollection a skos:Collection ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Year,
        pkmv:YearCluster,
        pkmv:YearHealth,
        pkmv:YearJournal,
        pkmv:YearLog,
        pkmv:YearPlan,
        pkmv:YearReview ;
    skos:note "All notes related to a calendar Year groups Quarters and Months."@en ;
    skos:prefLabel "Year Collection"@en .

