@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:AddFolder a skos:Concept ;
    rdfs:label "Add Folder"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Vault ;
    isothes:narrowerPartitive pkmv:Draft,
        pkmv:Focus,
        pkmv:Idea,
        pkmv:Spark ;
    skos:altLabel "Obsidian Inbox"@en,
        "Plus Folder"@en ;
    skos:broader pkmv:Vault ;
    skos:definition "The + (Add) folder is the PKM \"inbox\" space for new and incoming notes."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Draft,
        pkmv:Focus,
        pkmv:Idea,
        pkmv:Spark ;
    skos:prefLabel "Add Folder"@en ;
    skos:scopeNote "It's a pre-triage staging area before migrating into the heart of the PKM system (Ideaverse) in Atlas, Calendar, or Efforts."@en .

