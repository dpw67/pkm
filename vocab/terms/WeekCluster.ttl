@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:WeekCluster a skos:Concept ;
    rdfs:label "Week Cluster"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    isothes:broaderGeneric pkmv:TimeCluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:WeekAnalysis,
        pkmv:WeekDiabetes,
        pkmv:WeekDiabetesAnalysis,
        pkmv:WeekHealth,
        pkmv:WeekIndex,
        pkmv:WeekJournal,
        pkmv:WeekLog,
        pkmv:WeekMealPlan,
        pkmv:WeekPlan,
        pkmv:WeekReview ;
    skos:broader pkmv:CalendarFolder,
        pkmv:TimeCluster ;
    skos:definition "Everything the system produces about a single week — its index, plan, log, review, journal, analysis, health and meal-plan notes — taken as one whole rather than many notes of one kind."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:WeekAnalysis,
        pkmv:WeekDiabetes,
        pkmv:WeekDiabetesAnalysis,
        pkmv:WeekHealth,
        pkmv:WeekIndex,
        pkmv:WeekJournal,
        pkmv:WeekLog,
        pkmv:WeekMealPlan,
        pkmv:WeekPlan,
        pkmv:WeekReview ;
    skos:prefLabel "Week Cluster"@en ;
    skos:scopeNote "A sibling of DayCluster and MonthCluster under TimeCluster, not a rung between them: the week's own notes are its parts, and a day's belong to DayCluster."@en .

