pkmv:MealDomain skos:member pkmv:Ingredient .

pkmv:RecipeCollection skos:member pkmv:Ingredient .

pkmv:Ingredient a skos:Concept ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:Recipe ;
    skos:broader pkmv:Recipe ;
    skos:definition "An individual food item or component used in the preparation of a recipe."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Ingredient"@en ;
    skos:scopeNote "Recipe components, as modeled in the PKMMeals Ingredient type; distinguish from Nutrition (aggregate values) and RecipeSource (provenance)."@en .

