pkmv:DayCollection skos:member pkmv:DayMealPlan .

pkmv:MealDomain skos:member pkmv:DayMealPlan .

pkmv:DayMealPlan a skos:Concept ;
    rdfs:label "Day.Meal Plan"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterHealth ;
    skos:broader pkmv:DayClusterHealth ;
    skos:definition "The planned set of meals for a single day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day.Meal Plan"@en ;
    skos:scopeNote "Day-scoped meal planning: contains DayMeal entries and derives from the WeekMealPlan."@en .

