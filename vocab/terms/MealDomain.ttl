@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:MealDomain a skos:Collection ;
    rdfs:label "Meal Domain"@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Breakfast,
        pkmv:DMPMealPlan,
        pkmv:DayMealPlan,
        pkmv:Dinner,
        pkmv:Ingredient,
        pkmv:Lunch,
        pkmv:Meal,
        pkmv:MealPlan,
        pkmv:Nutrition,
        pkmv:PTEMealPlan,
        pkmv:RecipeImages,
        pkmv:RecipeServings,
        pkmv:RecipeSource,
        pkmv:RecipeTime,
        pkmv:Snack,
        pkmv:WeekMealPlan ;
    skos:note "Every concept in the meal-planning domain, across both the Meal and the Recipe side: the occasion, the meal kinds, the plans at each horizon, and the parts a recipe is assembled from. Wider than any one meal plan."@en ;
    skos:prefLabel "Meal Domain"@en .

