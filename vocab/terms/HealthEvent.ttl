@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:HealthEvent a skos:Concept ;
    rdfs:label "HealthEvent"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:Event ;
    isothes:narrowerGeneric pkmv:BloodPressureEvent,
        pkmv:DiabetesEvent,
        pkmv:EKGEvent,
        pkmv:MeditationEvent,
        pkmv:SleepEvent,
        pkmv:WeightEvent ;
    skos:broader pkmv:Event ;
    skos:definition "Something that happened related to Health."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:BloodPressureEvent,
        pkmv:DiabetesEvent,
        pkmv:EKGEvent,
        pkmv:MeditationEvent,
        pkmv:SleepEvent,
        pkmv:WeightEvent ;
    skos:prefLabel "HealthEvent"@en ;
    skos:scopeNote "Broader concept for all tracked health data points (GlucoseEvent, InsulinEvent, BloodPressureEvent, EKGEvent); populates DayClusterHealth and rolls up into WeekHealth/WeekDiabetes."@en .

