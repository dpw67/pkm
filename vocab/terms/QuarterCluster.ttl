@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:QuarterCollection skos:member pkmv:QuarterCluster .

pkmv:QuarterCluster a skos:Concept ;
    rdfs:label "Quarter Cluster"@en ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:TimeCluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:QuarterHealth,
        pkmv:QuarterJournal,
        pkmv:QuarterLog,
        pkmv:QuarterPlan,
        pkmv:QuarterReview ;
    skos:broader pkmv:CalendarFolder,
        pkmv:TimeCluster ;
    skos:definition "A group of related notes about a quarter."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:QuarterHealth,
        pkmv:QuarterJournal,
        pkmv:QuarterLog,
        pkmv:QuarterPlan,
        pkmv:QuarterReview ;
    skos:prefLabel "Quarter Cluster"@en ;
    skos:related pkmv:Quarter ;
    skos:scopeNote "Parent context for all notes associated with a quarter."@en .

