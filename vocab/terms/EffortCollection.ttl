@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortCollection a skos:Collection ;
    rdfs:label "Effort Collection"@en ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Area,
        pkmv:EffortCluster,
        pkmv:EffortsFolder,
        pkmv:Interest,
        pkmv:Project ;
    skos:note "The effort vocabulary rather than one effort's notes: the kinds of effort, the cluster that holds an effort's notes, and the folder they live in. It holds no member of any Effort Cluster, which is why it does not resemble the period collections."@en ;
    skos:prefLabel "Effort Collection"@en .

