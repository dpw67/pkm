pkmv:MealDomain skos:member pkmv:RecipeServings .

pkmv:RecipeCollection skos:member pkmv:RecipeServings .

pkmv:RecipeServings a skos:Concept ;
    rdfs:label "Recipe Servings"@en ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:Recipe ;
    skos:broader pkmv:Recipe ;
    skos:definition "The number of servings or portions a recipe yields."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Recipe Servings"@en ;
    skos:scopeNote "A recipe metadata attribute used for scaling and planning; part of the General/Details tab content."@en .

