@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCollection skos:member pkmv:Day .

pkmv:Day a skos:Concept ;
    rdfs:label "Day"@en ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    isothes:broaderPartitive pkmv:Week ;
    skos:broader pkmv:Calendar,
        pkmv:Week ;
    skos:definition "A single calendar day with 24 hours, the atomic unit of the temporal hierarchy of time periods (or time horizons)."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day"@en ;
    skos:related pkmv:DayCluster ;
    skos:scopeNote "Base temporal node in the Calendar subgraph: anchors PREV_DAY/NEXT_DAY ordering and all Day-prefixed note types in an Obsidian Ideaverse vault."@en .

