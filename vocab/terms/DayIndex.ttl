@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayIndex a skos:Concept ;
    dcterms:created "2026-08-26"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterCore ;
    skos:altLabel "Day Hub"@en,
        "Day Note"@en ;
    skos:broader pkmv:DayClusterCore ;
    skos:definition "The index note that links all artifacts for a given day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Index"@en ;
    skos:scopeNote "Hub note connecting DayPlan, DayLog, DayJournal, DayReview, and related notes for one Day."@en .

