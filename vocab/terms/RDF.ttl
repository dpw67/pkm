pkmv:RDF a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:W3CStandard ;
    skos:broader pkmv:W3CStandard ;
    skos:definition "Resource Description Framework - a W3C standard model for representing data as subject-predicate-object triples, forming the graph-based foundation for SKOS, OWL, and linked data."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "RDF"@en ;
    skos:scopeNote "The underlying triple model that SKOS and OWL are built on; pkm-vocab.export.ttl is serialized RDF in Turtle syntax."@en .

