@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MealDomain skos:member pkmv:Nutrition .

pkmv:RecipeCollection skos:member pkmv:Nutrition .

pkmv:Nutrition a skos:Concept ;
    rdfs:label "Nutrition"@en ;
    dcterms:created "2026-08-16"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:Recipe ;
    skos:broader pkmv:Recipe ;
    skos:definition "The nutrient content (e.g. calories, carbohydrates, fat, fiber) associated with a meal, recipe, or ingredient."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Nutrition"@en ;
    skos:scopeNote "Data parsed from recipe sources (PTE, DMP) in PKMMeals; used for tracking and analysis such as carbohydrate totals shown on recipe cards."@en .

