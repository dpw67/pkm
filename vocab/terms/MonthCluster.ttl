@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MonthCluster a skos:Concept ;
    rdfs:label "Month Cluster"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderGeneric pkmv:TimeCluster ;
    isothes:broaderPartitive pkmv:CalendarFolder ;
    isothes:narrowerPartitive pkmv:Month-Health,
        pkmv:MonthJournal,
        pkmv:MonthLog,
        pkmv:MonthPlan,
        pkmv:MonthReview ;
    skos:broader pkmv:CalendarFolder,
        pkmv:TimeCluster ;
    skos:definition "A group of related notes about a month."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Month-Health,
        pkmv:MonthJournal,
        pkmv:MonthLog,
        pkmv:MonthPlan,
        pkmv:MonthReview ;
    skos:prefLabel "Month Cluster"@en ;
    skos:related pkmv:Month ;
    skos:scopeNote "Parent context for all notes associated with a month."@en .

