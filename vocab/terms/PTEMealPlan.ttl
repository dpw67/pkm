@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:MealDomain skos:member pkmv:PTEMealPlan .

pkmv:PTEMealPlan a skos:Concept ;
    rdfs:label "PTE Meal Plan"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:MealPlan ;
    skos:broader pkmv:MealPlan ;
    skos:definition "A weekly meal plan built in Plan to Eat (PTE); a recipe, meal-planning, and shopping list subscription service."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "PTE Meal Plan"@en ;
    skos:scopeNote "Working meal plan assembled from DMP and other imported recipes; generates the weekly shopping list and syncs into the PKM Meals SwiftData database, as well as Neo4j graph database and Obsidian notes."@en .

