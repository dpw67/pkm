pkmv:SleepEvent a skos:Concept ;
    rdfs:label "Sleep Event"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    isothes:broaderGeneric pkmv:HealthEvent ;
    skos:broader pkmv:HealthEvent ;
    skos:definition "Recording metrics from overnight sleep."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Sleep Event"@en ;
    skos:scopeNote "- Capture information from Sleep Cycle and Apple Health apps."@en .

