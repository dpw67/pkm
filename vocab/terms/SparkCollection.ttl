@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:SparkCollection a skos:Collection ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Idea,
        pkmv:Spark ;
    skos:note "All the related notes for a new spark of interest or importance."@en ;
    skos:prefLabel "Spark Collection"@en .

