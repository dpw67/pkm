@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ConceptCollection skos:member pkmv:OWL .

pkmv:SemanticWebStandards skos:member pkmv:OWL .

pkmv:OWL a skos:Concept ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:W3CStandard ;
    skos:broader pkmv:W3CStandard ;
    skos:definition "Web Ontology Language - a W3C standard for authoring ontologies with formal, machine-processable semantics for classes, properties, and logical relationships."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "OWL"@en ;
    skos:scopeNote "The target language for the eventual Ontology stage (e.g. via Protege), building on the SKOS taxonomy."@en .

