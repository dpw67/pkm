@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:GraphDatabase a skos:Concept ;
    rdfs:label "Graph Database"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:narrowerPartitive pkmv:ContextGraph,
        pkmv:KnowledgeGraph,
        pkmv:MemoryGraph ;
    skos:definition "Graph databases that support a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:ContextGraph,
        pkmv:Cypher,
        pkmv:KnowledgeGraph,
        pkmv:MemoryGraph,
        pkmv:Neo4j,
        pkmv:Neo4jDesktop ;
    skos:prefLabel "Graph Database"@en ;
    skos:scopeNote """- Includes Neo4j Desktop, Neo4j Community, Neo4j Aura (cloud), LadybugDB using Cypher graph query language.
- Includes TypeDB using TypeQL."""@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

