pkmv:Health a skos:Concept ;
    rdfs:label "Health"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:Area ;
    skos:definition "An area that includes all aspects of your health."@en ;
