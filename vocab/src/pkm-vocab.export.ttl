pkmv:DexcomData a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Dexcom Data"@en ;
    rdfs:label "Dexcom Data"@en ;
    skos:definition "Diabetes data from Dexcom G7 15-day continuous glucose monitor (CGM) sensor."@en ;
    skos:scopeNote "- Includes data from Clarity website via the Dexcom API for glucose readings collected by sensor every 5 minutes."@en ;
