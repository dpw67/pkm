pkmv:Neo4jDesktop a skos:Concept ;
    rdfs:label "Neo4j Desktop"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:GraphDatabase ;
    skos:definition "Neo4j graph database that support a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Neo4j Desktop"@en ;
    skos:scopeNote "- Includes knowledge graph, context graph, memory (short-term and long-term), and PKM domain model."@en .

