@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:PKMPython a skos:Concept ;
    rdfs:label "PKM Python"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:definition "Python apps and services supporting PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:PKMPythonAPI,
        pkmv:PKMPythonAgents,
        pkmv:PKMPythonCommands,
        pkmv:PKMPythonScripts,
        pkmv:PKMPythonServices,
        pkmv:Python,
        pkmv:PythonTemplate ;
    skos:prefLabel "PKM Python"@en ;
    skos:scopeNote "Includes Python API routes, services, scripts, commands, and agents."@en ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> .

