pkmv:TopicJournal a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Topic Journal"@en ;
    rdfs:label "Topic Journal"@en ;
    skos:definition "Free-form reflective writing about a topic."@en ;
    skos:scopeNote "- Subjective narrative and reflection: complements the factual TopicLog. \n- Includes Morning Thoughts (First Light), Free-writing with narrative reflection and stream of thought, Interstitial journaling between sessions or activities, and Evening Thoughts (Last Light)."@en ;
    skos:changeNote "Added definiton and scope notes for a Topic Journal."@en, "2026-08-29 — Duplicated from “Topic Index” (by Doug Warren)", "2026-08-29 — Renamed from “TopicIndexCopy2” to “TopicJournal”; Preferred label changed from “Topic Index@en” to “Topic Journal@en” (by Doug Warren)", "2026-08-29 — Definition updated (by Doug Warren)", "2026-08-29 — Scope note updated (by Doug Warren)" ;
