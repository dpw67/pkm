pkmv:ClaudeAI a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:topConceptOf <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Claude AI"@en ;
    rdfs:label "Claude AI"@en ;
    skos:definition "Claude AI LLM (Sonnet or Opus models) that support a PKM system."@en ;
    skos:scopeNote "- Integrates AI with apps, services, scripts, commands, and agents.\n- Generates analysis notes in Obsidian such as Day Diabetes Analysis and Day Analysis using pkm-review services, scripts, commands, and agents.\n- Support an AI prompt library and additional dynamic AI chats with PKM system knowledge, context, and memory."@en ;
    skos:changeNote "Added definition and scope notes for Claude AI."@en, "2026-08-29 — Term created (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “ClaudeAI”; Preferred label “Claude AI@en” added; Definition added; Scope note added (by Doug Warren)", "2026-08-29 — Related term “PKM Python Services” added (by Doug Warren)" ;
