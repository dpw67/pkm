@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:LifeCollection a skos:Collection ;
    rdfs:label "Life Collection"@en ;
    skos:member pkmv:Life ;
    skos:note "All notes related to the top time horizon of a full lifespan."@en .

