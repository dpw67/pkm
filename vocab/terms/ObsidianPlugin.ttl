@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ObsidianPlugin a skos:Concept ;
    rdfs:label "Obsidian Plugin"@en ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-09-11"^^xsd:date ;
    skos:broader pkmv:ObsidianNotes ;
    skos:definition "A core or community plugin that extends available functions using JavaScript and the Obsidian API."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:AdvancedURI,
        pkmv:Bases,
        pkmv:BookSearch,
        pkmv:Canvas,
        pkmv:Dataview,
        pkmv:Excalidraw,
        pkmv:LocalRESTAPIWithMCP,
        pkmv:PeriodicNotes,
        pkmv:Publish,
        pkmv:QuickAdd,
        pkmv:Sync,
        pkmv:Templater,
        pkmv:Workspaces ;
    skos:prefLabel "Obsidian Plugin"@en ;
    skos:scopeNote "- Provides many additional useful features for the Obsidian app, such as Templater for templates, Periodic Notes for calendar notes, and many more."@en .

