# PKM Ontology — https://w3id.org/pkm/ontology
#
# HAND-AUTHORED. This file is the source of truth for the OWL model; it is not
# generated. Data-shape artifacts (SHACL, JSON Schema) are generated from
# schema/pkm.yaml into shapes/ — see the Makefile.
#
# The model is in development. The seed Note/Tag/Source classes that were minted
# when the namespace was registered have been removed: they referenced vocabulary
# terms that no longer exist. Only the ontology declaration remains, so
# https://w3id.org/pkm/ontology keeps resolving while the real classes are worked out.
#
# When classes arrive, do not link them to SKOS concepts with skos:exactMatch — the
# SKOS mapping properties have skos:Concept as their domain and range, so pointing
# one at an owl:Class is a type error. Use foaf:focus from the concept to the class,
# or rdfs:isDefinedBy from the class back to this ontology.

@prefix pkm:     <https://w3id.org/pkm/ontology#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

#################################################################
#    Ontology metadata
#################################################################

<https://w3id.org/pkm/ontology>
    a                             owl:Ontology ;
    dcterms:title                 "PKM Ontology"@en ;
    dcterms:description           """Classes, properties, and relationships for Personal
        Knowledge Management (PKM) within the Knowledge System Architecture (KSA)
        project, spanning Obsidian linked notes, a Neo4j knowledge graph, and
        associated tooling."""@en ;
    # Consider switching to <https://warrenweb.net/#me> once that IRI resolves.
    dcterms:creator               <https://github.com/dpw67> ;
    dcterms:license               <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:rights                "Copyright 2026 Doug Warren"@en ;
    dcterms:created               "2026-08-22"^^xsd:date ;
    owl:versionIRI                <https://w3id.org/pkm/ontology/0.1.0> ;
    owl:versionInfo               "0.1.0" ;
    vann:preferredNamespaceUri    "https://w3id.org/pkm/ontology#" ;
    vann:preferredNamespacePrefix "pkm" ;
    rdfs:seeAlso                  <https://w3id.org/pkm/vocab> .
