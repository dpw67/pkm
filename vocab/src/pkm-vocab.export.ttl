    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date .

pkmv:PKMStudio a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "PKM Studio"@en ;
    rdfs:label "PKM Studio"@en ;
    skos:definition "A SwiftUI app that manages a PKM knowledge system."@en ;
    skos:scopeNote "- Available on macOS, iOS, iPadOS, and watchOS.\n- Uses Python and Swift services, scripts, commands, and agents.\n- Integrates with Obsidian notes, Neo4j graph database, Claude AI LLM, and diabetes websites.\n- Provides functions via the App Intents framework to offer actions for use in Shortcuts (workflows), Siri AI (voice interface & natural language), or Spotlight (search).\n- Supports development and management of concepts, glossary, taxonomy, thesaurus, ontology, knowledge graph, schema, metadata, and associated development artifacts."@en ;
    skos:changeNote "Added definition and scope notes for PKM Studio."@en, "Removed as Top Concept and moved under PKM Swift."@en, "2026-08-29 — Duplicated from “PKM Meals” (by Doug Warren)", "2026-08-29 — Renamed from “PKMMealsCopy” to “PKMStudio”; Preferred label changed from “PKM Meals@en” to “PKM Studio@en”; Definition updated; Scope note updated (by Doug Warren)", "2026-08-29 — Parent “PKM Swift” added (by Doug Warren)", "2026-08-29 — Unmarked as a top concept (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:PKMSwift ;
    skos:broader pkmv:PKMSwift .

pkmv:Note a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Note"@en ;
    rdfs:label "Note"@en ;
    skos:definition "A unit of knowledge in a PKM system."@en ;
    skos:scopeNote "- Generally recommended to focus on a single idea.\n- Enables more reuse of knowledge and more focused linking."@en ;
    skos:changeNote "Added definition and scope notes for a Note."@en, "2026-08-29 — Term created under “Cluster” (by Doug Warren)", "2026-08-29 — Renamed from “NewConcept” to “Note”; Preferred label “Note@en” added; Definition added; Scope note added; Parent “Obsidian” added; Parent “Cluster” removed (by Doug Warren)" ;
    dcterms:creator agents:Doug-Warren ;
    dcterms:created "2026-08-29"^^xsd:date ;
    dcterms:issued "2026-08-15"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    skos:broader pkmv:ObsidianNotes .

pkmv:ObsidianPlugin a skos:Concept ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Obsidian Plugin"@en ;
    rdfs:label "Obsidian Plugin"@en ;
    skos:definition "A core or community plugin that extends available  functions using JavaScript and the Obsidian API."@en ;
    skos:scopeNote "- Provides many additional useful features for the Obsidian app, such as Templater for templates, Periodic Notes for calendar notes, and many more. "@en ;
    skos:changeNote "Added definition and scope notes for an Obsidian Plugin."@en, "2026-08-29 — Duplicated from “Note” (by Doug Warren)", "2026-08-29 — Renamed from “NoteCopy” to “ObsidianPlugin”; Preferred label changed from “Note@en” to “Obsidian Plugin@en”; Definition updated; Scope note updated (by Doug Warren)" ;
