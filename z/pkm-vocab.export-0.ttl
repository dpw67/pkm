pkm:taxonomy a skos:ConceptScheme ;
    dcterms:title "PKM taxonomy"@en ;
    dcterms:description "This PKM vocabulary includes concepts for personal knowledge management (PKM) system associated with my Knowledge System Architecture (KSA)."@en ;
    dcterms:creator pkm:agent2 ;
    dcterms:publisher pkm:agent2 ;
    dcterms:created "2026-08-15"^^xsd:date ;
    dcterms:issued "2026-08-23"^^xsd:date ;
    dcterms:modified "2026-08-25"^^xsd:date ;
    dcterms:rights "Content: CC BY 4.0; examples and build scripts: CC0 1.0"@en ;
    dcterms:language "en" ;
    skos:hasTopConcept pkm:Recipe, pkm:Concept, pkm:Day, pkm:Week, pkm:Knowledge, pkm:Action, pkm:Ingredient, pkm:Nutrition, pkm:RecipeTime, pkm:RecipeServings, pkm:RecipeSource, pkm:RecipeImages, pkm:Meal, pkm:MealPlan, pkm:Term, pkm:Metadata, pkm:Taxonomy, pkm:Ontology, pkm:KnowledgeGraph, pkm:SKOS, pkm:RDF, pkm:OWL, pkm:Neo4j, pkm:Cypher, pkm:Obsidian, pkm:Python, pkm:Swift, pkm:FastAPI, pkm:Hummingbird, pkm:Shortcut, pkm:Siri, pkm:AppIntent, pkm:Time, pkm:DayCluster, pkm:DayIndex, pkm:DayPlan, pkm:DayLog, pkm:DayJournal, pkm:DayReview, pkm:DayLinks, pkm:DayActions, pkm:DayHealth, pkm:DayDiabetes, pkm:DayDiabetesAnalysis, pkm:DayAnalysis, pkm:DaySchedule, pkm:WeekCluster, pkm:WeekIndex, pkm:WeekPlan, pkm:WeekLog, pkm:WeekJournal, pkm:WeekReview, pkm:WeekHealth, pkm:WeekDiabetes, pkm:WeekDiabetesAnalysis, pkm:WeekAnalysis, pkm:WeekMealPlan, pkm:Extra, pkm:Template, pkm:Script, pkm:Add, pkm:Draft, pkm:Clipping, pkm:Spark, pkm:Idea, pkm:Focus, pkm:Effort, pkm:Area, pkm:Interest, pkm:Project, pkm:Package, pkm:Food, pkm:Restaurant, pkm:Menu, pkm:MealPlan2, pkm:Recipe2, pkm:Tool, pkm:Effort2, pkm:Topic, pkm:Year, pkm:Life, pkm:Quarter, pkm:Calendar, pkm:Month, pkm:Decade, pkm:Calendar2, pkm:Cluster, pkm:Vault, pkm:Obsidian2 .

pkm:Recipe a skos:Concept ;
    skos:inScheme pkm:taxonomy ;
    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Recipe-xl-pref-1 ;
    skos:prefLabel "Recipe"@en ;
    skos:definition "A set of ingredients, instructions, and nutrition used to prepare, cook, and eat food for a meal."@en ;
    skos:scopeNote "Reusable building block referenced by meals; imported into Plan to Eat and stored in the PKM Meals SwiftData SQL database, Obsidian Markdown notes, and Neo4j knowledge graph."@en ;
    skos:changeNote "Added definition and scope notes to Recipe in SKOS editor."@en, "2026-08-16 — Parent “Meal” added (by Doug Warren)", "2026-08-16 — Parent “Meal” removed; Related term “Meal” added (by Doug Warren)", "2026-08-24 — Definition added; Scope note added; Related term “MealPlan” added; Related term “Meal” removed; Linked artifact “Recipe” added (by Doug Warren)" ;
    dcterms:source pkm:doc3 ;
    skos:related pkm:MealPlan ;
    isothes:broaderPartitive pkm:Meal ;
    rdfs:seeAlso <https://schema.org/Recipe> ;
    dcterms:created "2026-08-16T12:05:34Z"^^xsd:dateTime ;
    dcterms:modified "2026-08-24T17:00:19Z"^^xsd:dateTime .

pkm:Recipe-xl-pref-1 a skosxl:Label ;
    skosxl:literalForm "Recipe"@en .

pkm:Meal a skos:Concept ;
    isothes:narrowerPartitive pkm:Recipe ;
    skos:inScheme pkm:taxonomy ;
    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Meal-xl-pref-1 ;
    skos:prefLabel "Meal"@en ;
    skos:related pkm:MealPlan ;
    dcterms:created "2026-08-16T12:06:26Z"^^xsd:dateTime ;
    dcterms:modified "2026-08-16T12:06:26Z"^^xsd:dateTime ;
    skos:changeNote "2026-08-16 — Related term “MealPlan” added (by Doug Warren)" ;
    skos:narrower pkm:Dinner .

pkm:Meal-xl-pref-1 a skosxl:Label ;
	skosxl:literalForm "Meal"@en .

pkm:Concept a skos:Concept ;
    skos:inScheme pkm:taxonomy ;
    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Concept-xl-pref-1 ;
    skos:prefLabel "Concept"@en ;
    skos:definition "A unit of thought in a knowledge organization system."@en ;
    skos:scopeNote "An abstract idea independent of its label. It's how we organize ideas for browsing and retrieval. a PKM Concept is based on the SKOS standard skos:Concept."@en ;
    skos:changeNote "Added definition and scope notes for Concept."@en, "2026-08-24 — Definition added; Scope note added; Linked artifact “skos:Concept” added (by Doug Warren)" ;
    dcterms:source pkm:doc2, pkm:doc1 ;
    rdfs:seeAlso <https://skos.org#Concept> ;
    dcterms:created "2026-08-24T18:35:39Z"^^xsd:dateTime ;
    dcterms:modified "2026-08-24T18:35:39Z"^^xsd:dateTime .

pkm:Concept-xl-pref-1 a skosxl:Label ;
    skosxl:literalForm "Concept"@en .

pkm:Day a skos:Concept ;
    skos:inScheme pkm:taxonomy ;
    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Day-xl-pref-1 ;
    skos:prefLabel "Day"@en ;
    skos:definition "A single calendar day with 24 hours, the atomic unit of the temporal hierarchy of time periods (or time  horizons)."@en ;
    skos:scopeNote "Base temporal node in the Calendar subgraph: anchors PREV_DAY/NEXT_DAY ordering and all Day-prefixed note types in an Obsidian Ideaverse vault."@en ;
    skos:changeNote "Added definition and scope notes to Day."@en, "2026-08-16 — Related term “Day Cluster” added (by Doug Warren)", "2026-08-24 — Definition added; Scope note added; Related term “Day Index” added (by Doug Warren)", "2026-08-24 — Related term “Day Plan” added; Related term “Day Log” added; Related term “Day Journal” added; Related term “Day Review” added; Related term “Day Links” added; Related term “Day Actions” added; Related term “Day Schedule” added; Related term “Day Health” added; Related term “Day Diabetes” added; Related term “Day Diabetes Analysis” added; Related term “Day Analysis” added (by Doug Warren)" ;
    skos:related pkm:DayCluster, pkm:DayIndex, pkm:DayPlan, pkm:DayLog, pkm:DayJournal, pkm:DayReview, pkm:DayLinks, pkm:DayActions, pkm:DaySchedule, pkm:DayHealth, pkm:DayDiabetes, pkm:DayDiabetesAnalysis, pkm:DayAnalysis ;
    isothes:broaderPartitive pkm:Week ;
    dcterms:created "2026-08-16T12:07:00Z"^^xsd:dateTime ;
    dcterms:modified "2026-08-24T17:08:47Z"^^xsd:dateTime .

pkm:Day-xl-pref-1 a skosxl:Label ;
    skosxl:literalForm "Day"@en .

pkm:Week a skos:Concept ;
    isothes:narrowerPartitive pkm:Day ;
    skos:inScheme pkm:taxonomy ;
    skos:topConceptOf pkm:taxonomy ;
    skosxl:prefLabel pkm:Week-xl-pref-1 ;
    skos:prefLabel "Week"@en ;
    skos:definition "A seven-day time period grouping consecutive days."@en ;
    skos:scopeNote "Contains Days via IN_WEEK: parent time horizon for weekly planning, log, journal, and review artifacts."@en ;
