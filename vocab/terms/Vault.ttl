@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:Vault a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:ObsidianNotes ;
    isothes:narrowerPartitive pkmv:AddFolder,
        pkmv:ArchiveFolder,
        pkmv:AtlasFolder,
        pkmv:CalendarFolder,
        pkmv:EffortsFolder,
        pkmv:ExtraFolder ;
    skos:broader pkmv:ObsidianNotes ;
    skos:definition "A folder with all the Obsidian notes for a specific purpose, such as Ideaverse, etc."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:AddFolder,
        pkmv:ArchiveFolder,
        pkmv:AtlasFolder,
        pkmv:CalendarFolder,
        pkmv:EffortsFolder,
        pkmv:ExtraFolder,
        pkmv:Ideaverse,
        pkmv:ObsidianSettings ;
    skos:prefLabel "Vault"@en ;
    skos:scopeNote "Parent context for major spaces within an Obsidian linked-note system; Ideaverse recommends using major spaces: + (Add), Atlas (Knowledge), Calendar (Time), Efforts (Action), x (Extra/Support), and z (Archive)."@en .

