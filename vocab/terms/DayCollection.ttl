@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCollection a skos:Collection ;
    rdfs:label "Day Collection"@en ;
    dcterms:modified "2026-09-14"^^xsd:date ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:Day,
        pkmv:DayActions,
        pkmv:DayAnalysis,
        pkmv:DayBase,
        pkmv:DayBoard,
        pkmv:DayCanvas,
        pkmv:DayCluster,
        pkmv:DayClusterCore,
        pkmv:DayClusterHealth,
        pkmv:DayClusterSupport,
        pkmv:DayClusterVisual,
        pkmv:DayDiabetes,
        pkmv:DayDiabetesAnalysis,
        pkmv:DayDiagram,
        pkmv:DayDrawing,
        pkmv:DayHealth,
        pkmv:DayIndex,
        pkmv:DayJournal,
        pkmv:DayLinks,
        pkmv:DayLog,
        pkmv:DayMealPlan,
        pkmv:DayMindmap,
        pkmv:DayPlan,
        pkmv:DayReview,
        pkmv:DaySchedule,
        pkmv:DayView ;
    skos:note "The Day Cluster's parts listed flat, together with Day and Day Cluster themselves. It enumerates by hand what the hierarchy already derives, and the two have drifted: 26 members against 25 concepts under Day Cluster, with DayMeeting present in the tree and absent here. Where they disagree the hierarchy is authoritative."@en ;
    skos:prefLabel "Day Collection"@en .

