@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:YearCollection skos:member pkmv:Year .

pkmv:Year a skos:Concept ;
    rdfs:label "Year"@en ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:Calendar ;
    skos:broader pkmv:Calendar ;
    skos:definition "A calendar year grouping quarters and months."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Year"@en ;
    skos:related pkmv:YearCluster ;
    skos:scopeNote "Contains lower-level time horizons via IN_YAR: anchor for annual planning and retrospectives."@en .

