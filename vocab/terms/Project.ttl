@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:EffortCollection skos:member pkmv:Project .

pkmv:NoteTypes skos:member pkmv:Project .

pkmv:Project a skos:Concept ;
    rdfs:label "Project"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderGeneric pkmv:EffortsFolder ;
    skos:broader pkmv:EffortsFolder ;
    skos:definition "A defined, bounded effort with a specific goal and completion criteria, undertaken over a limited timeframe."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Project"@en ;
    skos:scopeNote "Per the PARA method; distinguish from Area (ongoing, no end state) and from the Effort Cluster / Output Cluster structures used specifically for content-series work."@en .

