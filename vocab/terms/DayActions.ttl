@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .
@prefix pkma: <https://w3id.org/pkm/agents#> .
@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:DayCollection skos:member pkmv:DayActions .

pkmv:DayActions a skos:Concept ;
    rdfs:label "Day Actions"@en ;
    dcterms:created "2026-08-27"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    isothes:broaderPartitive pkmv:DayClusterSupport ;
    skos:broader pkmv:DayClusterSupport ;
    skos:definition "A support note within a Day Cluster listing discrete Action items tracked for that day."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Day Actions"@en ;
    skos:scopeNote "Narrower than the general Action concept - the daily aggregation note, alongside DayLinks within DayClusterSupport."@en .

