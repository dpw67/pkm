@prefix pkmv: <https://w3id.org/pkm/vocab/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

pkmv:SemanticWebStandards a skos:Collection ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:member pkmv:ISOStandard,
        pkmv:KnowledgeGraph,
        pkmv:Metadata,
        pkmv:OWL,
        pkmv:Ontology,
        pkmv:RDF,
        pkmv:SKOS,
        pkmv:Standard,
        pkmv:Taxonomy,
        pkmv:Term,
        pkmv:W3CStandard ;
    skos:prefLabel "Semantic Web Standards"@en .

