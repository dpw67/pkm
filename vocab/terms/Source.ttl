pkmv:Source a skos:Concept ;
    dcterms:created "2026-08-25"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:Knowledge ;
    rdfs:seeAlso dcterms:bibliographicCitation,
        dcterms:conformsTo,
        dcterms:references,
        dcterms:source,
        <https://www.dublincore.org/specifications/dublin-core/dcmi-terms/elements11/source/> ;
    skos:broader pkmv:Knowledge ;
    skos:definition "A source of information from others that is used as input for developing your own ideas and knowledge in a PKM system."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:narrower pkmv:Book,
        pkmv:Clipping,
        pkmv:Movie,
        pkmv:Person,
        pkmv:Quote ;
    skos:prefLabel "Source"@en ;
    skos:scopeNote "- Includes a person, article, webpage, book, video, podcast, webinar, or course,"@en .

