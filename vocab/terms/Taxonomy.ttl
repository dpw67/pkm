@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pkmv:ConceptCollection skos:member pkmv:Taxonomy .

pkmv:SemanticWebStandards skos:member pkmv:Taxonomy .

pkmv:Taxonomy a skos:Concept ;
    rdfs:label "Taxonomy"@en ;
    dcterms:created "2026-08-28"^^xsd:date ;
    dcterms:creator pkma:Doug-Warren ;
    dcterms:issued "2026-08-28"^^xsd:date ;
    dcterms:modified "2026-08-29"^^xsd:date ;
    isothes:broaderPartitive pkmv:KnowledgeSystem ;
    skos:broader pkmv:KnowledgeSystem ;
    skos:definition "A hierarchical classification scheme that organizes concepts into broader/narrower relationships."@en ;
    skos:inScheme <https://w3id.org/pkm/vocab> ;
    skos:prefLabel "Taxonomy"@en ;
    skos:scopeNote "Refers to the SKOS concept scheme built in the SKOS Editor - the structural layer between the flat Glossary stage and the formal Ontology stage."@en .

